     <script type="text/javascript">

        //  $('#ClientSearch').change(function () {
        //     //ClientSearch();
        //     LoadSearchClientDetails();
        // });
   function runScript(e) {
       //See notes about 'which' and 'key'
       if (e.keyCode == 13) {
           if ($('#hrfClientId').val() != '') {
               LoadSearchClientDetails();
           }
           return false;
       }
   }
   function ClientSearch() {
       var eleClientSearch = $('#ClientSearch').autocomplete({
           scroll: true,
           minLength: 0,
           source: function (request, response) {
               $.ajax({
                   type: "POST",
                   dataType: "json",
                   url: $('#hrfSearchClient').val(),
                   data: { Prefix: request.term },
                   success: function (data) {
                       response($.map(data, function (item) {
                           return { label: item.value, value: item.value, CompanyId: item.id };
                       }));
                   },
                   error: function (req, status, error) {
                   }
               });
           },
           select: function (event, ui) {
               //hides();
               $('#hrfClientId').val(ui.item.CompanyId);
               LoadSearchClientDetails();

              // $('#ddlCheckListFor').val('');
              // $('#hdnCheckListFor').val('');
              //console.log($('#hrfClientId').val());
               return ui.item.value;
           },
       }).focus(function () {
           $(this).autocomplete("search", "");
       });
   }

   $('#btnSearch').on('click', function () {
       LoadSearchClientDetails();
   });


   $('#ClientSearch').change(function () {

    var companyId = $(this).val();

    if (companyId == "") {
        return;
    }
    var url ="@Url.Action("GetSearchClientDetails", "Admin")";
    var formData = new FormData();
       formData.append('Id', companyId);
    
       $.ajax({
           url: url,
           type: "POST",
           contentType: false,
           processData: false,
           data: formData,
           success: function (result) {
               if (result && result.data && result.data.length > 0) {
               $("#hrfClientId").val(result.data[0].companyId);               
               $("#ClientsDetails_CompanyId").val(result.data[0].companyName);
               $("#ClientsDetails_CompanyName").val(result.data[0].companyName);
               $("#hrfAccExeID").val(result.data[0].accountExecutiveID);
               //$('#@Html.IdFor(m => m.ClientsDetails.AccountExecutiveID)').val();
               $("#ClientsDetails_AccountExecutiveID").val(result.data[0].accountExecutiveID);                
               $("#ClientsDetails_LocationStreetAddress").val(result.data[0].address); 
               $("#ClientsDetails_CityId").val(result.data[0].cityId);
               $("#ClientsDetails_StateId").val(result.data[0].stateID);
               $("#ClientsDetails_ZipCode").val(result.data[0].zipCode);               
               //GetAccountExecutiveBasedOnCompanyID();
            }
               
           },
           error: function (err) {
           }
       });
    

});

   function LoadSearchClientDetails()
  {
       var client_id = $(this).val();

        if (client_id == "") {
            return;
        }
       //var client_id=$('#hrfClientId').val();
       console.log(client_id);
       var url ="@Url.Action("GetSearchClientDetails", "Admin")";
       var formData = new FormData();
       formData.append('Id', client_id);
       $.ajax({
           url: url,
           type: "POST",
           contentType: false,
           processData: false,
           data: formData,
           success: function (result) {
               if (result && result.data && result.data.length > 0) {
               $("#hrfClientId").val(result.data[0].companyId);               
               $("#ClientsDetails_CompanyId").val(result.data[0].companyName);
               $("#ClientsDetails_CompanyName").val(result.data[0].companyName);
               // $("#hrfAccExeID").val(result.data[0].accountExecutiveID);
               $("#ClientsDetails_AccountExecutiveID").val(result.data[0].accountExecutiveID);                
               $("#ClientsDetails_LocationStreetAddress").val(result.data[0].address); 
               $("#ClientsDetails_CityId").val(result.data[0].cityId);
               $("#ClientsDetails_StateId").val(result.data[0].stateID);
               $("#ClientsDetails_ZipCode").val(result.data[0].zipCode);
               $("#ClientsDetails_AccountExecutiveID").val('');
               
            }
               
           },
           error: function (err) {
           }
       });

  }
   function GetAccountExecutiveBasedOnCompanyID()
   {
       var compId=$('#hrfClientId').val();
       var url ="@Url.Action("GetAccountExecutiveDetails", "Admin")";
       var formData = new FormData();
       formData.append('Id', compId);
       $.ajax({
           url: url,
           type: "POST",
           contentType: false,
           processData: false,
           data: formData,
           success: function (result) {
               if (result && result.data && result.data.length > 0) { 
                   // $("#ClientsDetails_AccountExecutiveID").val('');
                   $("#hrfAccExeID").val(result.data[0].id);
                   $("#ClientsDetails_AccountExecutiveID").val(result.data[0].id);      
               }
               
           },
           error: function (err) {
           }
       });

   }
   </script>

}
