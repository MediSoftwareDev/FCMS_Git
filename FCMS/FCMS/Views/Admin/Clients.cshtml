        function AddContracts()
        {
            var GetContractTitle = $('#@Html.IdFor(m => m.ClientsDetails.ContractTitleId)').val();
            var GetContractSignedDate = $('#@Html.IdFor(m => m.ClientsDetails.ContractSignedDate)').val();
            var GetContractEffDate = $('#@Html.IdFor(m => m.ClientsDetails.ContractEffDate)').val();
            var GetContractExpiryDate = $('#@Html.IdFor(m => m.ClientsDetails.ContractExpiryDate)').val();
            var GetContractLength = $('#@Html.IdFor(m => m.ClientsDetails.ContractLength)').val();
            var GetAgreementType = $('#@Html.IdFor(m => m.ClientsDetails.AgreementTypeId)').val();

            var GetReferenceID = $('#hrfRefID').val() == '' ? 0 : $('#hrfRefID').val();

            var GetId = $('#@Html.IdFor(m => m.ClientsDetails.ContractID)').val();
            if ($('#btnContractAdd').val() == 'Add') {
                GetId = 0;
            }
            else {
                GetId = (GetId == "" ? 0 : GetId);
            }

            var GetVersion = 'V1';

            //var activ = true;
            //    if ($('.clsActive').is(':checked')) {
            //        activ = true;
            //    }
            //    else if ($('.clsInActive').is(':checked')) {
            //        activ = false;
            //    }
            var GetALS=$('#@Html.IdFor(m => m.ClientsDetails.ALS)').val();
            var GetALSNE=$('#@Html.IdFor(m => m.ClientsDetails.ALSNE)').val();
            var GetALS2=$('#@Html.IdFor(m => m.ClientsDetails.ALS2)').val();
            var GetBLS=$('#@Html.IdFor(m => m.ClientsDetails.BLS)').val();
            var GetBLSNE=$('#@Html.IdFor(m => m.ClientsDetails.BLSNE)').val();
            var GetMileage = $('#@Html.IdFor(m => m.ClientsDetails.Mileage)').val();

            GetALS = GetALS == '' ? 0 : GetALS;
            GetALSNE = GetALSNE == '' ? 0 : GetALSNE;
            GetALS2 = GetALS2 == '' ? 0 : GetALS2;
            GetBLS = GetBLS == '' ? 0 : GetBLS;
            GetBLSNE = GetBLSNE == '' ? 0 : GetBLSNE;
            GetMileage = GetMileage == '' ? 0 : GetMileage;


            var ClientsContractDetails = JSON.stringify({
                ID: GetId,
                ContractTitleId: GetContractTitle,
                ContractSignedDate: GetContractSignedDate,
                ContractEffDate: GetContractEffDate,
                ContractExpiryDate: GetContractExpiryDate,
                ContractLength: GetContractLength,
                ReferenceID: GetReferenceID,
                AgreementTypeId:GetAgreementType,
                Version: GetVersion,
                //Active: activ,
                ALS: GetALS,
                ALSNE: GetALSNE,
                ALS2: GetALS2,
                BLS: GetBLS,
                BLSNE: GetBLSNE,
                Mileage: GetMileage
            });

            if ($('#btnContractAdd').val() == 'Add') {
                var url = "@Url.Action("AddClientsContract", "Admin")";
            }
            else {
                var url = "@Url.Action("UpdateClientsContract", "Admin")";
            }

            var jsonData = ClientsContractDetails;
            AjaxRequestJsonPostContent(url, jsonData, function (resp, status, req) {
                if ($('#btnContractAdd').val() == 'Update') {

                    $('#divClientsEmployeeform').html(resp);
                    $('#hrfRefID').val($('#hrfReferenceId').val());
                    ClearContract();
                    $('#btnContractAdd').val('Add');
                    $('#Agreementfile').removeAttr('disabled');

                    CancelTeam();
                }
                else {
                    //Pace.on("start", function () {
                    //    ShowOverlay();
                    //    //$('body').addClass('overflow-hidden');
                    //    //$("#overlay").show();
                    //});

                    if (resp.contractId > 0) {
                        if (window.FormData !== undefined) {
                            ShowOverlay();
                            var formData = new FormData();
                            formData.append('file', $('#Agreementfile')[0].files[0]);
                            //formData.append('ClientId', resp.clientId);
                            formData.append('ReferenceId', resp.referenceId);
                            formData.append('ContractId', resp.contractId);
                            var url = "@Url.Action("SaveClientContractFiles", "Admin")";
                            $.ajax({
                                url: url,
                                type: "POST",
                                contentType: false,
                                processData: false,
                                data: formData,
                                success: function (result) {
                                    $('#divClientsEmployeeform').html(result);
                                    $('#hrfRefID').val($('#hrfReferenceId').val());
                                    ClearContract();
                                    $('#btnContractAdd').val('Add');
                                    CancelTeam();
                                    alert("Contract added successfully!");
                                    HideOverlay();
                                },
                                error: function (err) {
                                }
                            });
                        }
                    }

                    //Pace.on("done", function () {
                    //    HideOverlay();
                    //    //$('body').removeClass('overflow-hidden');
                    //    //$("#overlay").hide();
                    //});
                    //Pace.start();
                }

            });
        }

