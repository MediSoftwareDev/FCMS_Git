    function BuildData(type) {
        if (window.FormData !== undefined) {
            ShowOverlay();
            var formData = new FormData();
            formData.append('file', $('#UploadClientsfile')[0].files[0]);
            formData.append('Type', type);
            var url = "@Url.Action("ClientBulkUploadValidation", "Admin")";
            $.ajax({
                url: url,
                type: "POST",
                contentType: false,
                processData: false,
                data: formData,
                success: function (result) {
                    if (result.message == "HeadeFormatFailed" || result.message == "ColumnCountFailed")
                        $("#bulkErrorErrorMessage").text("Headings or Columns Count mismatching with the template");
                    else
                        $("#bulkErrorErrorMessage").text("");
                    $('#divBulkClientsList').html(result);
                    LoadBulkUploadClientsList();
                    loadUploadButton();
                    //location.href = $('#hrfClients').val();
                    HideOverlay();
                },
                error: function (err) {
                    HideOverlay();
                }
            });
        } else {
            //alert("FormData is not supported.");
        }
    }
        function LoadBulkUploadClientsList()
        {
            table = $('#tblBulkUploadClients').DataTable({
                searching: true,
                'aoColumnDefs': [{
                    'bSortable': false,
                    'aTargets': [0]
                }],
                "columnDefs": [
                        { "type": "num", "targets": 1 }
                ],
                "order": [ 1, 'desc' ],
                dom: 'l<"toolbar">frtip'
            });

            // Handle click on "Select all" control
            $('#checkAlle').on('click', function () {
                // Check/uncheck all checkboxes in the table
                var rows = table.rows({ 'search': 'applied' }).nodes();
                $('input[type="checkbox"]:not(":disabled")', rows).prop('checked', this.checked);
            });

            // Handle click on checkbox to set state of "Select all" control
            $('#tblBulkUploadClients tbody').on('change', 'input[type="checkbox"]', function () {
                // If checkbox is not checked
                if (!this.checked) {
                    var el = $('#checkAlle').get(0);
                    // If "Select all" control is checked and has 'indeterminate' property
                    if (el && el.checked && ('indeterminate' in el)) {
                        // Set visual state of "Select all" control
                        // as 'indeterminate'
                        el.indeterminate = true;
                    }
                }
            });
        }
    function CitiesOnchange()
    {
        $('.CitiesList').live('change', function () {
            var url = '@Url.Action("GetState", "Admin")';
            var CityId = $(this).val();
            var jsonData = { CityId: CityId };
            AjaxRequestJsonPost(url, jsonData, function (resp, status, req) {
                $($('#@Html.IdFor(m => m.ClientsDetails.StateId)')).get(0).options.length = 0;
                $("<option value = >Select a State</option>").appendTo($('#@Html.IdFor(m => m.ClientsDetails.StateId)'));
                $.each(resp, function (index) {
                    $('#@Html.IdFor(m => m.ClientsDetails.StateId)').append($("<option></option>").attr('value', this.id).text(this.value));
                });
            });

        });
    }
        function StatesOnchange() {
            $('.StatesList').live('change', function () {
                var StateId = $(this).val();
                $('#hfStateId').val(StateId);
                SetCity();
            });
        }

        function SetCity() {
            var StateId = $('#hfStateId').val();
            var CityId = $('#hfCityId').val();
            var url = '@Url.Action("GetCity", "Admin")';
            var jsonData = { StateId: StateId };


            AjaxRequestJsonPost(url, jsonData, function (resp, status, req) {
                $($('#@Html.IdFor(m => m.ClientsDetails.CityId)')).get(0).options.length = 0;
                $("<option value = >Select a City</option>").appendTo($('#@Html.IdFor(m => m.ClientsDetails.CityId)'));
                $.each(resp, function (index) {
                    $('#@Html.IdFor(m => m.ClientsDetails.CityId)').append($("<option></option>").attr('value', this.id).text(this.value));
                });
                if (CityId != 'undefined' && CityId != null && CityId != '') {
                    $($('#@Html.IdFor(m => m.ClientsDetails.CityId)')).val(CityId);
                }
            });
        }
        function Contract() {

            $("#Contract").change(function () {
                var ischecked = $(this).is(':checked');
                if (!ischecked)
                {
                    $('#divClientsEmployeeDetailsform').addClass("hide");
                    $('#divClientsEmployeeform').addClass("hide");
                }
            });

            $('#Contract').on('click', function () {
                //$($('#@Html.IdFor(m => m.ClientsDetails.ContractTitleId)')).get(0).options.length = 0;

                $('#NoContract').attr('checked', false);
                var GetContract = $('#Contract:checked').val();
                if (GetContract == "true") {
                    $('#divClientsEmployeeDetailsform').removeClass("hide");
                    $('#divClientsEmployeeform').removeClass("hide");
                }
            });
            $('#NoContract').on('click', function () {
                $('#Contract').attr('checked', false);
                var GetContract = $('#NoContract:checked').val();
                if (GetContract == "true") {
                    $('#divClientsEmployeeDetailsform').addClass("hide");
                    $('#divClientsEmployeeform').addClass("hide");
                }
            });
        }
    function createClients()
    {
        //Bind validation in ClientsForm
        $('#@Html.IdFor(m => m.ClientsDetails.CompanyId)').attr("data-parsley-required", true);
        $('#@Html.IdFor(m => m.ClientsDetails.CompanyName)').attr("data-parsley-required", true);

