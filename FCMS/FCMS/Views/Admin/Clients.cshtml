        $('#@Html.IdFor(m => m.ClientsDetails.AccountExecutiveID)').attr("data-parsley-required", true);



        //To check employee details list
        //if ($('#hrfRefID').val() == 0 && $('#@Html.IdFor(m => m.ClientsDetails.CompanyId)').val()==0)
        if ($('#Contract:checked').val() == 'true' && $('#hrfRefID').val() == 0)
        {
            $('#@Html.IdFor(m => m.ClientsDetails.ContractTitleId)').attr("data-parsley-required", true);
            $('#@Html.IdFor(m => m.ClientsDetails.ContractSignedDate)').attr("data-parsley-required", true);
            $('#@Html.IdFor(m => m.ClientsDetails.ContractEffDate)').attr("data-parsley-required", false);
            $('#@Html.IdFor(m => m.ClientsDetails.ContractExpiryDate)').attr("data-parsley-required", true);
            $('#@Html.IdFor(m => m.ClientsDetails.ContractLength)').attr("data-parsley-required", true);


            $('#@Html.IdFor(m => m.ClientsDetails.AgreementTypeId)').attr("data-parsley-required", true);
            $('#Agreementfile').attr("data-parsley-required", true);

            if ($('#@Html.IdFor(m => m.ClientsDetails.ALS)').val() == '')
            {
                $('#@Html.IdFor(m => m.ClientsDetails.ALSNE)').attr("data-parsley-required", true);
                $('#@Html.IdFor(m => m.ClientsDetails.ALS2)').attr("data-parsley-required", true);
                $('#@Html.IdFor(m => m.ClientsDetails.BLS)').attr("data-parsley-required", true);
                $('#@Html.IdFor(m => m.ClientsDetails.BLSNE)').attr("data-parsley-required", true);
                $('#@Html.IdFor(m => m.ClientsDetails.Mileage)').attr("data-parsley-required", true);
            }
            else {
                $('#@Html.IdFor(m => m.ClientsDetails.ALSNE)').attr("data-parsley-required", false);
                $('#@Html.IdFor(m => m.ClientsDetails.ALS2)').attr("data-parsley-required", false);
                $('#@Html.IdFor(m => m.ClientsDetails.BLS)').attr("data-parsley-required", false);
                $('#@Html.IdFor(m => m.ClientsDetails.BLSNE)').attr("data-parsley-required", false);
                $('#@Html.IdFor(m => m.ClientsDetails.Mileage)').attr("data-parsley-required", false);
                FeesChangeCalc();
            }
        }

        else {
            $('#@Html.IdFor(m => m.ClientsDetails.ContractTitleId)').attr("data-parsley-required", false);
            $('#@Html.IdFor(m => m.ClientsDetails.ContractSignedDate)').attr("data-parsley-required", false);
            $('#@Html.IdFor(m => m.ClientsDetails.ContractEffDate)').attr("data-parsley-required", false);
