    function diff_years(dt2, dt1) {
        var diff = (dt2.getTime() - dt1.getTime()) / 1000;
        diff /= (60 * 60 * 24);
        return Math.abs(Math.round(diff / 365.25));
    }

    function loadUploadButton() {
        $('#btnConfirmUpload').on('click', function () {
            var url = "@Url.Action("ClientBulkUpload", "Admin")";
            var BulkClientsDetailsList = [];
            var isMinChecked = false;

            //$('#tblBulkUploadClients tr.trClientsList').each(function () {
            table.$('tr.trClientsList').each(function () {
                if($(this).find('.clsSelect').is(':checked'))
                {
                    isMinChecked = true;
                    var BulkClientsDetails = {
                        Client: $.trim($(this).find('.tdClient').html()),
                        Description: $.trim($(this).find('.tdDescription').html()),
                        ResidencyCode: $.trim($(this).find('.tdResidencyCode').html()),
                        Fee1: $.trim($(this).find('.tdFee1').html()),
                        Fee2: $.trim($(this).find('.tdFee2').html()),
                        Fee3: $.trim($(this).find('.tdFee3').html()),
                        Fee4: $.trim($(this).find('.tdFee4').html()),
                        ContractStartSate: $.trim($(this).find('.tdContractStartSate').html()),
                        ContractRenewed: $.trim($(this).find('.tdContractRenewed').html()),
                        ContractExpires: $.trim($(this).find('.tdContractExpires').html()),
                        AccountOwner: $.trim($(this).find('.tdAccountOwner').html()),
                        Chief: $.trim($(this).find('.tdChief').html()),
                        Cemail: $.trim($(this).find('.tdCemail').html()),
                        Fiscal: $.trim($(this).find('.tdFiscal').html()),
                        Femail: $.trim($(this).find('.tdFemail').html()),
                        PhysicalLocationStreet: $.trim($(this).find('.tdPhysicalLocationStreet').html()),
                        PhysicalLocationCity: $.trim($(this).find('.tdPhysicalLocationCity').html()),
                        PhysicalLocationState: $.trim($(this).find('.tdPhysicalLocationState').html()),
                        PhysicalLocationZip: $.trim($(this).find('.tdPhysicalLocationZip').html()),
                        ContractFileName: $.trim($(this).find('.tdContractFileName').html()),
                        ContractFilePath: $.trim($(this).find('.tdContractFilePath').html()),
                        ContractFileMimeType: $.trim($(this).find('.tdContractFileMimeType').html()),
                        NonTransportBilled: $.trim($(this).find('.tdNonTransportBilled').html()),
                        NonTransportCharges: $.trim($(this).find('.tdNonTransportCharges').html()),
                        Notes: $.trim($(this).find('.tdNotes').html()),
                        ErrorMessage: ''
                    };
                    BulkClientsDetailsList.push(BulkClientsDetails);
                }
            });

            if (isMinChecked)
            {
                ShowOverlay();
                var data = JSON.stringify({
                    BulkClientsDetailsList: BulkClientsDetailsList
                });

                $.ajax({
                    url: url,
                    type: "POST",
                    contentType: "application/json; charset=utf-8",
                    processData: false,
                    data: data,
                    success: function (result) {
                        swal('Clients uploaded successfully!');
                        setTimeout(function () {
                            location.href = $('#hrfClients').val();
                        }, 2000)
                        HideOverlay();
                    },
                    error: function (err) {
                        HideOverlay();
                    }
                });
            }
            else {
                alert('No clients are selected');
            }
        });
    }
