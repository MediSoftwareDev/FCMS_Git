                "order": [ 0, 'asc' ],
                dom: 'l<"toolbar">frtip',
                initComplete: function () {
                    $("div.toolbar")
                       .html('<a id="btnClaimExport" href="javascript:;" class="" title="Download"><i class="fa fa-lg fa-file-excel-o text-success"></i> </a>');
                    $('#btnClaimExport').on('click', function () {
                        var url = "@Url.Action("DownloadClients", "Admin")";
                        var jsonData = {};
                        AjaxRequestJsonPostContent(url, jsonData, function (resp, status, req) {
                            const a = document.createElement('a');
                            a.style.display = 'none';
                            a.href = resp;
                            a.download = 'Clients.xlsx';
                            document.body.appendChild(a);
                            a.click();
                        });
                    });
                }
            });
        }

