@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@using FCMS.ViewModels.Admin
@model FacilityContractNameDetails;

@{
    string isAdmin = string.Empty;
    var RolePermission = HttpContextAccessor.HttpContext.Session.Get<string>("SessionRoleAccess");
    if (RolePermission == "R")
    {
        isAdmin = "hide";
    }
}

@section Styles {
    <link href='@Url.Content("~/css/DataTables.css")' rel="stylesheet" />
    <link href='@Url.Content("~/plugins/parsley/src/parsley.css")' rel="stylesheet" />
    <link href='@Url.Content("~/plugins/bootstrap-sweetalert/sweetalert.css")' rel="stylesheet" />
}
<input type="hidden" id="hrfFacilityContractName" value='@Url.Content("~/Admin/FacilityContractName/")' />
<div id="content" class="content">
    <ol class="breadcrumb pull-right">
        <li><a href="@Url.Action("Index","Home")">Home</a></li>
        <li><a href="javascript:;">Admin</a></li>
        <li class="active">Facility Contract Name</li>
    </ol>
    <h1 class="page-header">Facility Contract Name<small></small></h1>
    <div id="alertsuccess" class="alert alert-success alert-dismissable">
        <a href="#" class="close" data-dismiss="alert" aria-label="close">×</a>
        <strong>Success!</strong> Details saved.
    </div>
    <div id="alertinfo" class="alert alert-info alert-dismissable">
        <a href="#" class="close" data-dismiss="alert" aria-label="close">×</a>
        <strong>Sorry!</strong> Contract Exists.
    </div>
    <div id="divContractform">
        @{ Html.RenderPartial("_FacilityContractNameForm", Model); }
    </div>
    <div id="divContractList">
        @{ Html.RenderPartial("_FacilityContractNameList", Model); }

    </div>
</div>
@section Scripts
    {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src='@Url.Content("~/js/DataTables.js")'></script>
    <script src='@Url.Content("~/plugins/parsley/dist/parsley.js")'></script>
    <script src='@Url.Content("~/js/CommonEvents.js")'></script>
    <script src='@Url.Content("~/plugins/bootstrap-sweetalert/sweetalert.min.js")'></script>
    <script src='@Url.Content("~/js/ApplicationError.js")'></script>
    <script type="text/javascript">
        $(document).ready(function () {
        LoadContractList();
        $('#alertsuccess').hide();
        $('#alertinfo').hide();
        InitEvents();
        CancelTeam();
    });
    function createFacilityContractName()
    {
        var validationresult = $('#Contractform').parsley().validate();
        if (validationresult) {
            var Getname = $('#@Html.IdFor(m => m.FacilityContractNameDet.Name)').val();
            var GetId = $('#@Html.IdFor(m => m.FacilityContractNameDet.Id)').val();
            GetId = (GetId == "" ? 0 : GetId);
            var ContractDetails = JSON.stringify({
                Id: GetId,
                Name: Getname
            });
            var url = "@Url.Action("InsertFacilityContractName", "Admin")";
            var jsonData = ContractDetails;
            AjaxRequestJsonPostContent(url, jsonData, function (resp, status, req) {
                $('#divContractList').html(resp);
                $('.collapse').hide();
                $('#btnSubmit').val('Submit');
                
                $('#expandcollapse').find('i').removeClass('fa-minus').addClass('fa-plus');
                $('#Contractform').parsley().destroy();
                ClearForm();
                LoadContractList();
                // SweetAlert Success Message
                
                Swal.fire({
                    icon: 'success',
                    title: 'Success!',
                    text: 'Facility Contract Name has been saved successfully.',
                    confirmButtonText: 'OK'
                });
            });
        }
    }


    function ClearForm()
    {
        $('#Contractform').find('input:text').val('');
        $("textarea").val("");
        $('#Contractform').find('input:radio').removeAttr('checked');
        $('#Contractform').find('select').val(0);
       // $('#EmployeePositionDetails_Id').val('');
    }

        $('#btnSubmit').live('click', function () {
            createFacilityContractName();
            $("#changeteam").html("Add Facility Contract Name");
    });
         $('#@Html.IdFor(m => m.FacilityContractNameDet.Name)').on('blur', function () {
             var Value = $(this).val();
             if (Value != 0) {
                 $("#spanContractst").hide();
                 $.ajax({
                     url: "@Url.Action("IsFacilityContractNameExist", "Admin")",
                     type: "POST",
                 data: { FacilityContractName: Value },
                 success: function (data) {
                     SetSessionExpireTimer();
                     if (data.message == "Failed") {
                         $("#spanContractst").show();
                         $('#@Html.IdFor(m => m.FacilityContractNameDet.Name)').focus();
                     }
                     else {
                         $("#spanContractst").hide();
                     }
                 },
                 error: function (result) {
                     console.log("Filed Ajax");
                 }
             });
         }
        });


        function LoadContractList() {
            $('#tblContractList').DataTable({
            searching: true,
            'aoColumnDefs': [{
                'bSortable': false,
                'aTargets': [-1]
            }]
        });
    }
    function CancelTeam(){
        $('#btnCancel').click(function (e) {
        swal({
            title: "Are you sure?",
            text: "Data in the page will be lost!",
            type: "info",
            showCancelButton: true,
            confirmButtonClass: 'btn-primary',
            confirmButtonText: 'Confirm'
        },
            function (isConfirm) {
                if (isConfirm) {
                    location.href = $('#hrfFacilityContractName').val();
                }
            });
        });
    }

    function ConfirmDelete(RID) {
        $("#alertsuccess").hide();
        $('#alertinfo').hide();
        swal({
            title: "Are you sure?",
            text: "You will not be able to recover this detail!",
            type: "error",
            showCancelButton: true,
            confirmButtonClass: 'btn-danger',
            confirmButtonText: 'Yes, delete it!'
        },
    function (isConfirm) {
        if (isConfirm) {
                var url = "@Url.Action("DeleteFacilityContractName", "Admin")";
            var jsonData = { ID: RID };
                AjaxRequestJsonPost(url, jsonData, function (resp, status, req) {
                    if (resp.message == "Failed") {
                        $('#alertinfo').show();
                        setTimeout(function () {
                            $('#alertinfo').hide();
                            $('#alertinfo').removeClass('show');
                        }, 2000);
                        LoadContractList();
                    }
                    else
                    {
                        $('#alertinfo').hide();
                        $('#divContractList').html(resp);
                        ClearForm();
                        LoadContractList();
                    }
                });
            }
            else {
                return false;
            }
    });
};
    </script>
}


