@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@using FCMS.ViewModels.Contract
@model Contracts
@{
    string isAdmin = string.Empty;
    var RolePermission = HttpContextAccessor.HttpContext.Session.Get<string>("SessionRoleAccess");
    if (RolePermission == "R")
    {
        isAdmin = "hide";
    }
}
<div class="row panel-body">
    <table id="tblClients" class="table table-striped table-bordered table-hover">
        <thead>
            <tr>
                @*<th>Sno</th>
                    <th>Company ID</th>
                    <th>Company Name</th>*@
                @*<th>Residency Code</th>*@
                <th>Facility Name</th>
                <th>Facility Contract Effective Date</th>
                <th>Facility Contract Expiry Date</th>
                <th>Account Executive</th>
                <th>Active</th>
                @*<th class="hidden">Action</th>*@
            </tr>
        </thead>
        <tbody>

            @{int i = 0;
                foreach (var item in Model.ClientContractsDBList)
                {
                    i++;
                    <tr id="@item.Id" href="javascript:;" data-ContractTitleID="@item.ContractTitleID"
                        class="btnClientView">
                        @*<td id="txtSno" class="tr1">@i</td>
                            <td id="txtContractTitle" class="tr1">@item.CompanyId</td>
                            <td id="txtContractSignedDate" class="tr1">@Html.Raw(item.CompanyName)</td>*@
                        <td id="txtContractTitle" class="tr1">@item.ContractTitle</td>
                        <td id="txtContractSignedDate" class="tr1">@Html.Raw(item.ContractSignedDate)</td>
                        <td id="txtContractExpiryDate" class="tr1">@item.ContractExpiryDate</td>
                        <td id="txtAccountExecutiveName" class="tr1">@item.AccountExecutiveName</td>
                        <td id="txtConActive" class="tr1">@item.Active</td>
                        @*<td id="txtSignedDate" class="tr1">@item.ContractRenewedDate</td>
                                <td id="txtExpiryDate" class="tr1">@item.ContractExpiryDate</td>
                            <td id="txtStatus" class="tr1" hidden="hidden">
                                @if (item.Active)
                                {<span>Yes</span>}
                                else
                                {<span>No</span>}
                            </td>*@
                        @*<td id="txtAction" class="tr1" hidden="hidden"><a href="javascript:;" data-compname="@item.CompanyName"
                            data-compId="@item.CompanyId" class="fa fa-eye btnClientView"></a></td>*@

                    </tr>
                }
            }
        </tbody>
    </table>
</div>