        function SetClientSearch(companyName)
        {
            var downKeyEvent = $.Event("keydown");
            downKeyEvent.keyCode = $.ui.keyCode.DOWN; // event for pressing "down" key

            var enterKeyEvent = $.Event("keydown");
            enterKeyEvent.keyCode = $.ui.keyCode.ENTER; // event for pressing "enter" key

            $('#ClientSearch').autocomplete("search", companyName);
            $('#ClientSearch').autocomplete("option", "autoFocus", true);
            setTimeout(function () {
                $("#ClientSearch").trigger(enterKeyEvent); // Enter key selects highlighted item
                $('#btnSearch').trigger('click');
            }, 2000);
        }

