        function logDatatable()
        {
            $("#divContractList").addClass('hide');
            $("#divContractList").addClass('show');
            var dtTblList;
            PageValue = $('#Page').val();
            if ($.fn.DataTable.isDataTable('#tblContarctHistoryTable')) {
                dtTblList = $('#tblContarctHistoryTable').DataTable().ajax.reload();

            } else
            {
                dtTblList = $('#tblContarctHistoryTable').DataTable(
                   {
                       ajax: {
                           url: '@Url.Content("~/Contract/ClientContractsLog1")',
                           type: "POST",
                           datatype: "json",
                           data: function (d) {
                               d.contractId = $('#hrfClientId').val();
                           },
                           error: function (result) {
                               console.log(result);
                           }
                       },
                       columns: [
                            { data: "version", name: "version" },
                           { data: "logTime", name: "date" },
                           { data: "userName", name: "actionby" },
                           { data: "status", name: "action" },
                           { data: "comments", name: "comments" },
                       ],
                       autoWidth: false,
                       order: [],
                       language: {
                           processing: "Processing...Please Wait"
                       }

                   })
                $(dtTblList.table().container()).removeClass('form-inline');


            }
        }

        function OtherDocumentDatatable() {
            $("#divContractList").addClass('hide');
            $("#divContractList").addClass('show');
            var dtTblList;
            if ($.fn.DataTable.isDataTable('#tblContractOtherDocumentTable')) {
                dtTblList = $('#tblContractOtherDocumentTable').DataTable().ajax.reload();

            } else {
                dtTblList = $('#tblContractOtherDocumentTable').DataTable(
                   {
                       ajax: {
                           url: '@Url.Content("~/Contract/ClientContractsOtherDocument")',
                           type: "POST",
                           datatype: "json",
                           data: function (d) {
                               d.contractId = $('#hrfClientId').val();
                           },
                           error: function (result) {
                               console.log(result);
                           }
                       },
                       columns: [
                           { data: "documentName", name: "documentname" },
                           { data: "uploadedBy", name: "uploaded by" },
                           { data: "uploadedOn", name: "uploaded on" },
                       ],
                       columnDefs: [
                       {
                           targets: 0,
                           render: function (data, type, row, meta) {
                               //console.log(row);
                               var DocName = row["documentName"];
                               var fileName = row["fileName"];
                               var clientId = row["clientId"];

                               var linktext = '@Html.ActionLink("Doc*","ViewOtherContractFile", "Contract", new { fileName = "FN**", clientId = "CI**"}, new { @target = "_blank", style = "border:none; background-color:transparent;display: initial;" })';
                               linktext = linktext.replace('FN**', escape(fileName)).replace('CI**', clientId).replace('Doc*', DocName);
                               return linktext
                               //'<a href="' + row["fileName"] + '" id="' + row["id"] + '" target="_blank" style="border:none; background-color:transparent;display: initial;">' + row["documentName"] + '</a>';
                           }
                       },
                       {
                           targets: 3,
                           render: function (data, type, row, meta) {
                               return '<a href="javascript:;" id="' + row["id"] + '" class="btnOtherDocFilesdelete fa fa-lg fa-trash-o text-inverse form-control1 p-l-0 p-r-0 m-5 @isPermission" style="border:none; background-color:transparent;display: initial;"></a>';

                           }
                       }
                       ],
                       autoWidth: false,
                       order: [0, "desc"],
                       language: {
                           processing: "Processing...Please Wait"
                       }

                   })
                $(dtTblList.table().container()).removeClass('form-inline');

                $('#tblContractOtherDocumentTable tbody td .btnOtherDocFilesdelete').live('click', function () {
                    var tr = $(this).closest('tr');
                    var DocID = $(this).attr("id");

                    ConfirmOtherDocumentDelete(DocID);
                });
            }
        }

        function NotesDatatable() {
            var dtTblList;
            if ($.fn.DataTable.isDataTable('#tblContractNotesTable')) {
                dtTblList = $('#tblContractNotesTable').DataTable().ajax.reload();

            } else {
                dtTblList = $('#tblContractNotesTable').DataTable(
                   {
                       ajax: {
                           url: '@Url.Content("~/Contract/ClientContractsNotesDetails")',
                           type: "POST",
                           datatype: "json",
                           data: function (d) {
                               d.ContractTitleID = $('#hrfContractTitleID').val();
                           },
                           error: function (result) {
                               console.log(result);
                           }
                       },
                        columns: [
                            { data: "contractTitle", name: "contractTitle" },
                           { data: "notes", name: "notes" },
                           { data: "addedBy", name: "added by" },
                           { data: "addedOn", name: "added on" },
                       ],
                       columnDefs: [
                       {
                           targets: 4,
                           render: function (data, type, row, meta) {
                               var Edit = '<a href="javascript:;" id="' + row["id"] + '" class="btnNotesedit fa fa-lg fa-edit text-inverse form-control1 p-l-0 p-r-0 m-5 @*@isPermission*@" style="border:none; background-color:transparent;display: initial;"></a>';
                               var Delete = '<a href="javascript:;" id="' + row["id"] + '" class="btnNotesdelete fa fa-lg fa-trash-o text-inverse form-control1 p-l-0 p-r-0 m-5 @*@isPermission*@" style="border:none; background-color:transparent;display: initial;"></a>';

                               if (row["userID"] == '@UserId' || '@RoleId' == '2c0cdf89-9984-4f82-bcf3-f3382e5a843c')
                                   return Edit + Delete;
                               else
                                   return '';
                           }
                       }
                       ],
                       autoWidth: false,
                       order: [],
                       language: {
                           processing: "Processing...Please Wait"
                       }

                   })
                $(dtTblList.table().container()).removeClass('form-inline');

                $('#tblContractNotesTable tbody td .btnNotesdelete').live('click', function () {
                    var tr = $(this).closest('tr');
                    var NotesID = $(this).attr("id");
                    $("#hrfCommonNotesId").val(NotesID);
                    ConfirmNotesDelete(NotesID);
                });

                $('#tblContractNotesTable tbody td .btnNotesedit').live('click', function () {
                    var tr = $(this).closest('tr');
                    var NotesID = $(this).attr("id");
                    EditNote(NotesID);

                });


                LoadContractTitle();
            }
        }
        function LoadContractTitle() {
            var url = "@Url.Action("GetContractTitle", "Contract")";
            var formData = new FormData();
            formData.append('ClientId', $('#hrfClientId').val());

            $.ajax({
                url: url,
                type: "POST",
                contentType: false,
                processData: false,
                data: formData,
                success: function (result) {

                },
                error: function (err) {
                }
            });
        }

        //Delete Notes
        function EditNote(NotesID) {
            var url = "@Url.Action("EditNotes", "Contract")";
            var formData = new FormData();
            formData.append('Id', NotesID);

            $.ajax({
                url: url,
                type: "POST",
                contentType: false,
                processData: false,
                data: formData,
                success: function (result) {
                    $("#hrfCommonNotesId").val(NotesID);
                    $("#hrfContractId").val(result.data[0]["contractId"]);
                    $("#CommonNote").val(result.data[0]["notes"]);
                    $("#btnNoteSubmit").prop('value', 'Update');

                    if (result.data[0]["contractId"] != 'undefined' && result.data[0]["contractId"] != null && result.data[0]["contractId"] != '') {
                        $($('#@Html.IdFor(m => m.ClientContractNotesDetails.ContractId)')).val(result.data[0]["contractId"]);
                    }
                },
                error: function (err) {
                }
            });
        };

        //Delete Notes
        function ConfirmNotesDelete(NotesID) {
            var response = swal({
                title: "Are you sure?",
                text: "You will not be able to recover this detail!",
                type: "error",
                showCancelButton: true,
                confirmButtonClass: 'btn-danger',
                confirmButtonText: 'Yes, delete it!'
            },
                function (isConfirm) {
                    if (isConfirm) {
                        var url = "@Url.Action("DeleteClientContractNotes", "Contract")";
                        var jsonData = { Id: NotesID };
                        AjaxRequestJsonPost(url, jsonData, function (resp, status, req) {
                            $("#hrfCommonNotesId").val("");
                            NotesDatatable();
                            logDatatable();
                        });
                    }
                    else {
                        return false;
                    }
                });
        };

        //Delete ContractOtherDocument from contractlist
        function ConfirmOtherDocumentDelete(DocID) {
            var response = swal({
                title: "Are you sure?",
                text: "You will not be able to recover this detail!",
                type: "error",
                showCancelButton: true,
                confirmButtonClass: 'btn-danger',
                confirmButtonText: 'Yes, delete it!'
            },
                function (isConfirm) {
                    if (isConfirm) {
                        var url = "@Url.Action("DeleteOtherDocument", "Contract")";
                        var jsonData = { Id: DocID };
                        AjaxRequestJsonPost(url, jsonData, function (resp, status, req) {

                            OtherDocumentDatatable();
                            var formData = new FormData();
                            formData.append('companyId', $('#hrfClientId').val());
                            formData.append('Version', "v");
                            formData.append('ContractId', $('#hrfContractId').val());
                            formData.append('Status', 'Other Documents Deleted');

                            var url = "@Url.Action("UpdateViewDetails", "Contract")";
                            $.ajax({
                                url: url,
                                type: "POST",
                                contentType: false, // Not to set any content header
                                processData: false, // Not to process data
                                data: formData,
                                success: function (result) {
                                    logDatatable();
                                    OtherDocumentDatatable();
                                    NotesDatatable();
                                },
                                error: function (err) {

                                }
                            });

                        });
                    }
                    else {
                        return false;
                    }
                });
        };

