        function ConfirmContractDelete(ContractId, companyId, Version, Contract,Status) {
            var response = swal({
                title: "Are you sure?",
                text: "You will not be able to recover this detail!",
                type: "error",
                showCancelButton: true,
                confirmButtonClass: 'btn-danger',
                confirmButtonText: 'Yes, delete it!'
            },
                function (isConfirm) {
                    if (isConfirm) {
                        var url = "@Url.Action("DeleteContract", "Contract")";
                        var jsonData = { Id: ContractId};
                        AjaxRequestJsonPost(url, jsonData, function (resp, status, req) {
                            $('#hfrDataClientID').val(resp.clientId);
                            //History
                            History(companyId, Version, Contract, Status);
                            //Reload
                            Datatable();
                        });
                    }
                    else {
                        return false;
                    }
                });
        };



        function createContractDetails()
        {
            @*$('#@Html.IdFor(m => m.ClientContractDetails.AgreementType)').attr("data-parsley-required", true);*@
            $('#Agreementfile').attr("data-parsley-required", true);

            var validationresult = $('#contractdetailsfrm').parsley().validate();
            if (validationresult)
            {

                var GetAgreementType = $('#@Html.IdFor(m => m.ClientContractDetails.AgreementTypeId)').val();
                var GetClientId = $('#@Html.IdFor(m => m.ClientContractDetails.ClientId)').val() == "" ? $('#hrfClientId').val() : $('#@Html.IdFor(m => m.ClientContractDetails.ClientId)').val();
                var GetContractSignedDate = $('#@Html.IdFor(m => m.ClientsDetails.ContractSignedDate)').val();
                var GetContractExpiryDate = $('#@Html.IdFor(m => m.ClientsDetails.ContractExpiryDate)').val();
                var GetReferenceID = $('#hrfContractRefID').val();

                var GetId = $('#hrfContractId').val();
                GetId = (GetId == "" ? 0 : GetId);

                if (GetAgreementType == '1')
                {
                    if ($('#Agreementfile').val() != '')
                        SaveContractFiles();
                    History(GetClientId,"V1",GetId,"Contract Modified");
                    //if ($('#OtherDocumentfile').val() != '')
                    //    SaveClientContractOtherFiles();
                }
                else {
                    if ($('#Agreementfile').val() != '') {
                        var ClientContractEditDetails = JSON.stringify({
                            ID: GetId,
                            ClientId: GetClientId,
                            AgreementType: GetAgreementType,
                            ContractSignedDate: GetContractSignedDate,
                            ContractExpiryDate: GetContractExpiryDate,
                            ReferenceID: GetReferenceID
                        });
                        var jsonData = ClientContractEditDetails;

                        var url = "@Url.Action("SaveContractDetails", "Contract")";
                        AjaxRequestJsonPostContent(url, jsonData, function (resp, status, req) {

                            $('#hrfContractId').val(resp.contractId)
                            SaveContractFiles();
                            $('.btnedit').addClass('hide');
                            //if ($('#OtherDocumentfile').val() != '')
                            //    SaveClientContractOtherFiles();
                        });
                    }
                }
            }

           // AfterContractSubmit();
        }

