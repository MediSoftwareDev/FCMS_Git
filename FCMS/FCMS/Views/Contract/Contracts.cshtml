            formData.append('ClientId', $('#hrfClientId').val());
            formData.append('ContractId', $('#hrfContractId').val());

            var url = "@Url.Action("SaveContractFiles", "Contract")";
            $.ajax({
                url: url,
                type: "POST",
                contentType: false, // Not to set any content header
                processData: false, // Not to process data
                data: formData,
                success: function (result) {
                    //$('#divClientSearch').html(result);
                    //$('#divClientDetails').removeClass('hide');
                    AfterContractSubmit();
                    Datatable();
                    logDatatable();
                    OtherDocumentDatatable();
                    NotesDatatable();
                },
                error: function (err) {

                }
            });
        }

