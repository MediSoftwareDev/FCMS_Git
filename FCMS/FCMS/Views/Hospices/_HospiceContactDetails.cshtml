@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@using FCMS.ViewModels.Hospices;
@model Hospices
@{
    string isAdmin = string.Empty;
    var RolePermission = HttpContextAccessor.HttpContext.Session.Get<string>("SessionRoleAccess");
    if (RolePermission == "R")
    {
        isAdmin = "hide";
    }
}
@if (RolePermission == "F")
{
    <form id="ClientContractDetailsfrm" method="post" class="form-horizontal" data-parsley-validate="true">
        <h4>Add Hospice Contacts</h4>
        <hr />
        @*<input type="hidden" id="hfId" value="@Model.HospicesContacts.ID" />*@
        <div class="panel-body panel-form p-t-15 m-t-10">
            <div class="row col-12 p-10" id="HospicesContacts">

                <div class="form-group col-sm-12 col-md-12 col-lg-12 p-0">
                    @Html.HiddenFor(m => m.HospicesContacts.ID)
                    <div class="form-group col-sm-4 col-md-4 col-lg-4 p-0">
                        <label class="control-label col-md-4 col-sm-4" for="ClientSpecific">Client Specific@*<span style="color:red">*</span>*@</label>
                        <div class="col-md-8 col-sm-8 col-lg-8 controls">
                            @Html.DropDownListFor(m => m.HospicesContacts.ClientName, new SelectList(Model.ClientSpecificList, "Id", "Value"), "ALL Clients", new { @class = "form-control", data_parsley_required = "true" })
                        </div>
                    </div>
                    <div class="form-group col-sm-4 col-md-4 col-lg-4 p-0">
                        <label class="control-label col-md-4 col-sm-4" for="ZipCode">Contact Name@*<span style="color:red">*</span>*@</label>
                        <div class="col-md-8 col-sm-8 col-lg-8 controls" data-parsley-validate="true">
                            @Html.TextBoxFor(m => m.HospicesContacts.ContactName, new { @class = "form-control", @placeholder = "Enter Contact Name", data_parsley_required = "true" })
                        </div>
                    </div>
                    <div class="form-group col-sm-4 col-md-4 col-lg-4 p-0">
                        <label class="control-label col-md-4 col-sm-4" for="Address">Phone@*<span style="color:red">*</span>*@</label>
                        <div class="col-md-8 col-sm-8 col-lg-8 controls">
                            @Html.TextBoxFor(m => m.HospicesContacts.Phone, new { @class = "form-control", @placeholder = "Enter Phone", data_parsley_required = "true" })
                        </div>
                    </div>
                </div>
                <div class="form-group col-sm-12 col-md-12 col-lg-12 p-0">
                    <div class="form-group col-sm-4 col-md-4 col-lg-4 p-0">
                        <label class="control-label col-md-4 col-sm-4" for="State">Fax Number@*<span style="color:red">*</span>*@</label>
                        <div class="col-md-8 col-sm-8 col-lg-8 controls">
                            @Html.TextBoxFor(m => m.HospicesContacts.FaxNumber, new { @class = "form-control", @placeholder = "Enter Fax Number", data_parsley_required = "true" })
                        </div>
                    </div>
                    <div class="form-group col-sm-4 col-md-4 col-lg-4 p-0">
                        <label class="control-label col-md-4 col-sm-4" for="City">Email ID@*<span style="color:red">*</span>*@</label>
                        <div class="col-md-8 col-sm-8 col-lg-8 controls">
                            @Html.TextBoxFor(m => m.HospicesContacts.EmailID, new { @class = "form-control", @placeholder = "Enter Email ID", data_parsley_required = "true" })
                        </div>
                    </div>
                    <div class="form-group col-sm-4 col-md-4 col-lg-4 p-0">
                        <div class="col-lg-2">
                        </div>
                        <div class="col-lg-10">
                            <div class="form-group col-sm-12 col-md-12 col-lg-12 p-0  controls">
                                <input type="button" id="btnHospiceContactAdd" class="btn btn-sm btn-info m-t-5 @isAdmin" value="Add" />
                                @*<input type="button" id="btnCancel" class="btn btn-sm btn-default m-r-5" value="Cancel" />*@
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
}
