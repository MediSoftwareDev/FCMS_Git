@using FCMS.ViewModels.Hospitals
@model Hospitals
<form id="userForm" method="post" class="form-horizontal">
    <div class="panel-body panel-form p-t-15  m-t-10">
        <div class="form-group col-sm-12 col-md-12 col-lg-12" id="Companyfilter">
            <label class="control-label col-md-4 col-sm-4">Name</label>
            <div class="col-md-3 col-sm-3 col-lg-3 controls" onkeypress="return runScript(event)">
                @Html.TextBox("HospitalSearch", null, new { @class = "form-control", @placeholder = "Enter Name ", data_parsley_required = "true" })
            </div>
            <div class="col-md-3 col-sm-3 col-lg-3 controls">
                <input id="btnSearch" type="button" class="btn btn-sm btn-primary m-r-5 hide" value="Search" />
            </div>
        </div>
        <div class="hide m-10" id="divHospitalDetails">
            <h4>Hospital Details</h4>
            <hr />
            <div class="table-responsive" data-scrollbar="true" data-init="true">
                <table class="table table-profile width-full">
                    <tbody>
                        <tr>
                            @Html.HiddenFor(m => m.HospitalDetails.ID)
                            @Html.HiddenFor(m => m.HospitalDetails.ContractPricing)
                            @Html.HiddenFor(m => m.HospitalDetails.LetterIncluded)
                            @Html.HiddenFor(m => m.HospitalDetails.W9)
                            @Html.HiddenFor(m => m.HospitalDetails.VendorLetter)
                            @Html.HiddenFor(m => m.HospitalDetails.InvoiceTemplate)
                            @Html.HiddenFor(m => m.HospitalDetails.LetterPath)
                            @Html.HiddenFor(m => m.HospitalDetails.W9Path)
                            @Html.HiddenFor(m => m.HospitalDetails.VendorPath)
                            @Html.HiddenFor(m => m.HospitalDetails.InvoiceTemplatePath)
                            @Html.HiddenFor(m => m.HospitalDetails.IsAlert)
                            <td style="width: 6%!important" class="field p-l-5 p-r-0 text-success text-left">Name</td>
                            <td style="width: 1%!important" class="field text-success">:</td>
                            <td style="width: 15%!important" class="p-l-5 p-r-2">@Html.DisplayFor(m => m.HospitalDetails.Name)</td>
                            @*<td style="width: 10%!important" class="field p-l-5 p-r-0 text-success text-left">Phone</td>
                                <td style="width: 1%!important" class="field text-success">:</td>
                                <td style="width: 15%!important" class="p-l-5 p-r-2">@Html.DisplayFor(m => m.HospitalDetails.Phone) </td>*@

                            <td style="width: 10%!important" class="field p-l-5 p-r-0 text-success text-left">State</td>
                            <td style="width: 1%!important" class="field text-success">:</td>
                            <td style="width: 15%!important" class="p-l-5 p-r-2"> @Html.DisplayFor(m => m.HospitalDetails.StateName)</td>

                            <td style="width: 10%!important" class="field p-l-5 p-r-0 text-success text-left">Client Specific</td>
                            <td style="width: 1%!important" class="field text-success">:</td>
                            <td style="width: 15%!important" class="p-l-5 p-r-2">@Html.DisplayFor(m => m.HospitalDetails.ClientSpecificName) </td>
                            <td style="width: 10%!important" class="field p-l-5 p-r-0 text-success text-left">Contract Pricing</td>
                            <td style="width: 1%!important" class="field text-success">:</td>
                            <td style="width: 15%!important" class="p-l-5 p-r-2 ContractPricing">@Html.DisplayFor(m => m.HospitalDetails.ContractPricing) </td>
                        </tr>
                        <tr>
                            <td style="width: 6%!important" class="field p-l-5 p-r-0 text-success text-left">Address</td>
                            <td style="width: 1%!important" class="field text-success">:</td>
                            <td style="width: 15%!important" class="p-l-5 p-r-2">@Html.DisplayFor(m => m.HospitalDetails.Address) </td>
                            @*<td style="width: 10%!important" class="field p-l-5 p-r-0 text-success text-left">Fax Number</td>
                                <td style="width: 1%!important" class="field text-success">:</td>
                                <td style="width: 15%!important" class="p-l-5 p-r-2">@Html.DisplayFor(m => m.HospitalDetails.FaxNumber)</td>*@

                            <td style="width: 10%!important" class="field p-l-5 p-r-0 text-success text-left">Zip Code</td>
                            <td style="width: 1%!important" class="field text-success">:</td>
                            <td style="width: 15%!important" class="p-l-5 p-r-2">@Html.DisplayFor(m => m.HospitalDetails.ZipCode)</td>

                            <td style="width: 10%!important" class="field p-l-5 p-r-0 text-success text-left">Invoice Preference</td>
                            <td style="width: 1%!important" class="field text-success">:</td>
                            <td style="width: 15%!important" class="p-l-5 p-r-2 InvoicePreference">@Html.DisplayFor(m => m.HospitalDetails.InvoiceP) </td>
                            <td style="width: 10%!important" class="field p-l-5 p-r-0 text-success text-left">Invoice Schedule</td>
                            <td style="width: 1%!important" class="field text-success">:</td>
                            <td style="width: 15%!important" class="p-l-5 p-r-2">@Html.DisplayFor(m => m.HospitalDetails.InvoiceSchedule)</td>
                        </tr>
                        <tr>
                            <td style="width: 6%!important" class="field p-l-5 p-r-0 text-success text-left">City</td>
                            <td style="width: 1%!important" class="field text-success">:</td>
                            <td style="width: 15%!important" class="p-l-5 p-r-2">@Html.DisplayFor(m => m.HospitalDetails.CityName) </td>
                            @*<td style="width: 10%!important"  class="field p-l-5 p-r-0 text-success text-left">EmailID</td>
                                <td style="width: 1%!important" class="field text-success">:</td>
                                <td style="width: 15%!important" class="p-l-5 p-r-2"> @Html.DisplayFor(m => m.HospitalDetails.EmailID)</td>*@

                            <td style="width: 10%!important" class="field p-l-5 p-r-0 text-success text-left">Department</td>
                            <td style="width: 1%!important" class="field text-success">:</td>
                            <td style="width: 15%!important" class="p-l-5 p-r-2"> @Html.DisplayFor(m => m.HospitalDetails.Department)</td>

                            <td style="width: 10%!important" class="field p-l-5 p-r-0 text-success text-left">Letter Included</td>
                            <td style="width: 1%!important" class="field text-success">:</td>
                            <td style="width: 15%!important" class="p-l-5 p-r-2 LetterIncluded"> @Html.DisplayFor(m => m.HospitalDetails.LetterIncluded)</td>
                            <td style="width: 10%!important" class="field p-l-5 p-r-0 text-success text-left">W-9</td>
                            <td style="width: 1%!important" class="field text-success">:</td>
                            <td style="width: 15%!important" class="p-l-5 p-r-2 W9">@Html.DisplayFor(m => m.HospitalDetails.W9)</td>
                        </tr>
                        <tr>
                            @*<td style="width: 6%!important" class="field p-l-5 p-r-0 text-success text-left">State</td>
                                <td style="width: 1%!important" class="field text-success">:</td>
                                <td style="width: 15%!important" class="p-l-5 p-r-2"> @Html.DisplayFor(m => m.HospitalDetails.StateName)</td>*@
                            @*<td style="width: 10%!important" class="field p-l-5 p-r-0 text-success text-left">Contact Name</td>
                                <td style="width: 1%!important" class="field text-success">:</td>
                                <td style="width: 15%!important" class="p-l-5 p-r-2"> @Html.DisplayFor(m => m.HospitalDetails.ContactName)</td>*@
                            <td style="width: 48%!important" colspan="6" class="field p-l-5 p-r-0 text-success text-left"></td>
                            <td style="width: 10%!important" class="field p-l-5 p-r-0 text-success text-left">Vendor Letter</td>
                            <td style="width: 1%!important" class="field text-success">:</td>
                            <td style="width: 15%!important" class="p-l-5 p-r-2 VendorLetter">@Html.DisplayFor(m => m.HospitalDetails.VendorLetter)</td>
                            <td style="width: 10%!important" class="field p-l-5 p-r-0 text-success text-left">Invoice Template</td>
                            <td style="width: 1%!important" class="field text-success">:</td>
                            <td style="width: 15%!important" class="p-l-5 p-r-2 InvoiceTemplate">@Html.DisplayFor(m => m.HospitalDetails.InvoiceTemplate)</td>
                        </tr>
                        @*<tr>
                                <td style="width: 6%!important" class="field p-l-5 p-r-0 text-success text-left">Zip Code</td>
                                <td style="width: 1%!important" class="field text-success">:</td>
                                <td style="width: 15%!important" class="p-l-5 p-r-2">@Html.DisplayFor(m => m.HospitalDetails.ZipCode)</td>
                                <td style="width: 10%!important" class="field p-l-5 p-r-0 text-success text-left">Department</td>
                                <td style="width: 1%!important" class="field text-success">:</td>
                                <td style="width: 15%!important" class="p-l-5 p-r-2"> @Html.DisplayFor(m => m.HospitalDetails.Department)</td>
                            </tr>*@
                    </tbody>
                </table>
            </div>

            <div id="divHospitalContractDetails" class="hide">
                @{ await Html.RenderPartialAsync("_HospitalContractDetails"); }
            </div>
        </div>
    </div>
</form>