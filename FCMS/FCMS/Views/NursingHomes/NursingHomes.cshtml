       function ConfirmDelete(NursingHomeID) {
            $("#alertsuccess").hide();
            swal({
                title: "Are you sure?",
                text: "You will not be able to recover this detail!",
                type: "error",
                showCancelButton: true,
                confirmButtonClass: 'btn-danger',
                confirmButtonText: 'Yes, delete it!'
            },
            function (isConfirm) {
                if (isConfirm) {
                    var url = "@Url.Action("DeleteNursingHomes", "NursingHomes")";
                    var jsonData = { NursingHomeID: NursingHomeID };
                    AjaxRequestJsonPost(url, jsonData, function (resp, status, req) {
                        $('#divNursingHomeList').html(resp);
                        //$('#alertsuccess').show();
                        $('#btnNursingHomeSubmit').val('Submit');
                        $("#tNursingHomeSearchHead").click();

                        //setTimeout(function () {
                        //    $('#alertsuccess').hide();
                        //    $('#alertsuccess').removeClass('show');
                        //}, 2000);
                        $('#NursingHomesfrm').parsley().destroy();
                        ClearForm();
                        LoadNursingHomeList();
                        location.href = $('#hrfNursingHomes').val();
                    });
                }
                else {
                    return false;
                }
            });
        };
       function CancelTeam() {
            $('#btnCancel').click(function (e) {
                swal({
                    title: "Are you sure?",
                    text: "Data in the page will be lost!",
                    type: "info",
                    showCancelButton: true,
                    confirmButtonClass: 'btn-primary',
                    confirmButtonText: 'Confirm'
                },
                    function (isConfirm) {
                        if (isConfirm) {
                            location.href = $('#hrfNursingHomes').val();
                        }
                    });
            });
        }

