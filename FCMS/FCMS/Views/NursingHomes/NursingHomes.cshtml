        $('#@Html.IdFor(m => m.NursingHomesContacts.ContactName)').val(ContactName);
        $('#@Html.IdFor(m => m.NursingHomesContacts.Phone)').val(Phone);
        $('#@Html.IdFor(m => m.NursingHomesContacts.FaxNumber)').val(FaxNumber);
        $('#@Html.IdFor(m => m.NursingHomesContacts.EmailID)').val(EmailID);
        $('#@Html.IdFor(m => m.NursingHomesContacts.BillType)').val(BillType);
        $('#@Html.IdFor(m => m.NursingHomesContacts.Instructions)').val(Instructions);

        $('#btnNursingHomeContactAdd').val('Update');
    }

    function ConfirmNursingHomeContactDelete(ID,RefID) {
         swal({
                title: "Are you sure?",
                text: "You will not be able to recover this detail!",
                type: "error",
                showCancelButton: true,
                confirmButtonClass: 'btn-danger',
                confirmButtonText: 'Yes, delete it!'
            },
            function (isConfirm) {
                if (isConfirm) {
                    var url = "@Url.Action("DeleteNursingHomesContacts", "NursingHomes")";
                    var jsonData = { NursingHomeContactID: ID };
                    AjaxRequestJsonPost(url, jsonData, function (resp, status, req) {
                        NursingHomeContactsDatatable(0, RefID)
                    });
                }
                else {
                    return false;
                }
            });
    }
    </script>
}

