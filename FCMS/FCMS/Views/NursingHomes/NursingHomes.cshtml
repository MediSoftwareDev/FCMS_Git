@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@using FCMS.ViewModels.NursingHomes
@model NursingHomes
@{
    string isAdmin = string.Empty;
    string isPermission = string.Empty;
    var Changeproject = HttpContextAccessor.HttpContext.Session.Get<List<UserProjectRole>>("Changeproject");
    var RoleId = HttpContextAccessor.HttpContext.Session.Get<string>("SessionRoleID");
    var NotificationCount = HttpContextAccessor.HttpContext.Session.Get<string>("NotificationCount");
    var RolePermission = HttpContextAccessor.HttpContext.Session.Get<string>("SessionRoleAccess");
    string UserId = HttpContextAccessor.HttpContext.Session.Get<string>("SessionUserID");
    if (RoleId == "194c4cc1-4a1e-4861-abbb-302d02f7d825")
    {
        isAdmin = "AE";
    }
    if (RolePermission == "R")
    {
        isPermission = "hide";
    }

}
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>NursingHomes</title>
    @section Styles {
        <link href='@Url.Content("~/css/DataTables.css")' rel="stylesheet" />
        <link href='@Url.Content("~/css/BootstrapDatepicker.css")' rel="stylesheet" />
        <link href='@Url.Content("~/plugins/DataTables/media/css/dataTables.bootstrap.min.css")' rel="stylesheet" />
        <link href='@Url.Content("~/plugins/simple-line-icons/css/simple-line-icons.css")' rel="stylesheet" />
        <link href='@Url.Content("~/plugins/bootstrap-sweetalert/sweetalert.css")' rel="stylesheet" />
        <link href='@Url.Content("~/plugins/parsley/src/parsley.css")' rel="stylesheet" />

        <style>
            td.details-control {
                background: url('~/img/details_open.png') no-repeat center center;
                cursor: pointer;
            }

            tr.shown td.details-control {
                background: url('~/img/details_close.png') no-repeat center center;
            }


            .input-daterange input {
                text-align: left !important;
            }

            #tblErrorList tfoot .form-control {
                padding-left: 3px !important;
                height: 20px;
                font-size: 11px;
                font-weight: normal;
            }

            tfoot {
                display: table-header-group !important;
            }

            .modal-dialog {
                width: 970px !important;
                margin: 30px auto;
            }

            .lbl-align {
                text-align: left !important;
                font-weight: 700;
            }

            #userForm hr {
                margin-top: 5px !important;
                margin-bottom: 10px !important;
            }

            #userForm h4 {
                margin: 0px;
                padding-left: 10px;
            }

            .head-div {
                float: right;
                margin-top: -30px;
            }

            .ui-autocomplete {
                overflow: auto;
                height: 300px;
            }

            #divNursingHomeDetails .form-group {
                margin-right: 0px !important;
                margin-left: 0px !important;
                margin-bottom: 0px !important;
            }

            #divNursingHomeDetails .text-success {
                color: #009591 !important;
            }

            .ui-front {
                z-index: 2000 !important;
            }

            .text-decoration {
                text-decoration: none !important;
            }
        </style>

        <style type="text/css">
            .toolbar {
                float: right !important;
                margin: 10px !important;
            }
        </style>
    }

</head>
<body>
    <input type="hidden" id="hrfNursingHomes" value='@Url.Content("~/NursingHomes/NursingHomes")' />
    <input type="hidden" id="hrfContractDetails" value='@Url.Content("~/Contract/Contracts/")' />
    <input type="hidden" id="hrfSearchClient" value='@Url.Content("~/NursingHomes/GetSearchNursingHome")' />
    <input type="hidden" id="hrfNursingHomeId" value="" />
    <input type="hidden" id="hrfCompanyname" value="" />
    <input type="hidden" id="hrfContractId" value="" />
    <input type="hidden" id="hrfStatus" value="" />
    <input type="hidden" id="hrfStatusID" value="" />
    <input type="hidden" id="hfReviewYear" />
    <input type="hidden" id="hfrClientID" value="" />
    <input type="hidden" id="hfrDataClientID" value=0 />
    <input type="hidden" id="hrfSentBy" value="" />
    <input type="hidden" id="hrfMailTo" value="" />
    <input type="hidden" id="hrfMailAttachment" value="" />
    <input type="hidden" id="hrfContractRefID" value="" />

    <input type="hidden" id="hrfContactRefID" value="" />

    <div class="content" id="content">
        <ol class="breadcrumb pull-right">
            <li><a href="@Url.Action("Index","Home")">Home</a></li>
            <li><a href="javascript:;">Clients & Contracts</a></li>
            <li class="active">Contract</li>
        </ol>
        <h1 class="page-header">Nursing Home<small></small></h1>

        <ul class="nav nav-tabs customtab" role="tablist">
            <li class="nav-item @isAdmin"> <a class="nav-link" data-toggle="tab" id="tNursingHomeSearchHead" href="#divNursingHomeSearchHead" role="tab"><span class="hidden-sm-up"><i class="fa fa-search"></i></span> <span class="hiddpen-xs-down">Nursing Home Search</span></a> </li>
            <li class="nav-item @isAdmin"> <a class="nav-link" data-toggle="tab" id="tNursingHomeAddHead" href="#divNursingHomeAddHead" role="tab"><span class="hidden-sm-up"><i class="fa fa-user"></i></span> <span class="hidpden-xs-down">Add Nursing Home</span></a> </li>
            @*<li class="nav-item @isAdmin"> <a class="nav-link" data-toggle="tab" id="tNursingHomeBulkUploadHead" href="#divNursingHomeBulkUploadHead" role="tab"><span class="hidden-sm-up"><i class="fa fa-users"></i></span> <span class="hidpden-xs-down">Bulk Nursing Home Upload</span></a> </li>*@
        </ul>
        <div id="alertsuccess" class="alert alert-success alert-dismissable">
            <a href="#" class="close" data-dismiss="alert" aria-label="close">×</a>
            <strong>Success!</strong> Details saved.
        </div>
        <div class="tab-pane active" id="divNursingHomeSearchHead" role="tabpanel">
            <div class="panel panel-inverse" data-sortable-id="form-validation-1">
                <div class="panel-heading">
                    <div class="panel-heading-btn">
                        <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default" id="expandcollapse" data-click="panel-collapse" data-original-title="" title="" data-init="true"><i class="fa fa-minus"></i></a>
                    </div>
                    <h4 class="panel-title" id="changeTeam">Nursing Home Search</h4>
                </div>
                <div id="divNursingHomeSearch">
                    @{ await Html.RenderPartialAsync("_NursingHomeSearch"); }
                </div>

                <div id="divNursingHomeOtherDetails" class="m-1 hide">

                    <ul class="nav nav-tabs customtab" role="tablist">
                        <li class="nav-item"> <a class="nav-link" data-toggle="tab" id="tNursingHomeContacts" href="#divNursingHomeContacts" role="tab"><span class="hidden-sm-up"><i class="fa fa-sticky-note"></i></span> <span class="hidpden-xs-down">Contacts</span></a> </li>
                        <li class="nav-item"> <a class="nav-link" data-toggle="tab" id="tCommonNotes" href="#divCommomNotes" role="tab"><span class="hidden-sm-up"><i class="fa fa-sticky-note"></i></span> <span class="hidpden-xs-down">Notes</span></a> </li>
                        <li class="nav-item"> <a class="nav-link" data-toggle="tab" id="tversionhistory" href="#divVersionHistroy" role="tab"><span class="hidden-sm-up"><i class="fa fa-history"></i></span> <span class="hidpden-xs-down">History</span></a> </li>
                    </ul>
                    <div class="tab-pane" id="divNursingHomeContacts" role="tabpanel">
                        <div id="NursingHomeContacts">
                            @{ await Html.RenderPartialAsync("_NursingHomeContactList", Model); }
                        </div>
                    </div>
                    <div class="tab-pane" id="divCommomNotes" role="tabpanel">
                        <div id="CommomNotes">
                            @{ await Html.RenderPartialAsync("_NursingHomeNotes", Model); }
                        </div>
                    </div>
                    <div class="tab-pane" id="divVersionHistroy" role="tabpanel">
                        <div id="VersionHistroy">
                            @{ await Html.RenderPartialAsync("_NursingHomeHistory", Model); }
                        </div>
                    </div>

                </div>
                @if (Model.NursingHomeList != null)
                {
                    <div id="divNursingHomeList">
                        @{await Html.RenderPartialAsync("_NursingHomeList", Model); }
                    </div>
                }
            </div>
        </div>
        <div class="tab-pane" id="divNursingHomeAddHead" role="tabpanel">
            <div id="divNursingHomeAdd">
                @{await Html.RenderPartialAsync("_NursingHomeAdd", Model); }
            </div>
        </div>
        <div class="tab-pane" id="divNursingHomeBulkUploadHead" role="tabpanel">
        </div>
    </div>
</body>
</html>

@section Scripts{
    <script src='@Url.Content("~/js/DataTables.js")'></script>
    <script src='@Url.Content("~/plugins/parsley/dist/parsley.js")'></script>
    <script src='@Url.Content("~/plugins/DataTables/media/js/dataTables.bootstrap.js")'></script>
    <script src='@Url.Content("~/js/ui-modal-notification.demo.min.js")'></script>
    <script src='@Url.Content("~/plugins/bootstrap-sweetalert/sweetalert.js")'></script>
    <script src='@Url.Content("~/plugins/bootstrap-datepicker/js/bootstrap-datepicker.js")'></script>
    <script src='@Url.Content("~/plugins/masked-input/masked-input.min.js")'></script>
    <script src='@Url.Content("~/js/CommonUtils.js")'></script>

    <script type="text/javascript">
        $(document).ready(function () {
            Notification.init();
            NursingHomeSearch();
            BtnSearch();
            LoadNursingHomeList();
            StatesOnchange();
            CheckBox();
            CancelTeam();
            fromDashboard();

            $('#alertNotessuccess').hide();

            $("#tNursingHomeSearchHead").click();
            $("#divNursingHomeAddHead").hide();
            $("#divNursingHomeBulkUploadHead").hide();


            $('#alertsuccess').hide();

            $("#tNursingHomeContacts").click();
            $("#CommomNotes").hide();
            $("#VersionHistroy").hide();

            $(".nav-link").click(function () {
                ClearForm();
                var tabid = this.id;
                if (tabid == "tNursingHomeSearchHead") {

                    $("#divNursingHomeSearchHead").show();
                    $("#divNursingHomeAddHead").hide();
                    $("#divNursingHomeBulkUploadHead").hide();


                    $('#divNursingHomeDetails').addClass('hide');
                    $('#divNursingHomeList').removeClass('hide');

                    $('#divNursingHomeOtherDetails').removeClass('show');
                    $("#divNursingHomeOtherDetails").addClass('hide');

                }
                else if (tabid == "tNursingHomeAddHead") {
                    $("#divNursingHomeSearchHead").hide();
                    $("#divNursingHomeAddHead").show();
                    $("#divNursingHomeBulkUploadHead").hide();
                }
                else if (tabid == "tNursingHomeBulkUploadHead") {
                    $("#divNursingHomeSearchHead").hide();
                    $("#divNursingHomeAddHead").hide();
                    $("#divNursingHomeBulkUploadHead").show();
                }
                else if (tabid == "tversionhistory") {
                    $("#VersionHistroy").show();
                    $("#CommomNotes").hide();
                    $("#NursingHomeContacts").hide();
                }
                else if (tabid == "tNursingHomeContacts") {
                    $("#VersionHistroy").hide();
                    $("#CommomNotes").hide();
                    $("#NursingHomeContacts").show();
                }
                else if (tabid == "tCommonNotes") {
                    $("#VersionHistroy").hide();
                    $("#NursingHomeContacts").hide();
                    $("#CommomNotes").show();

                    $("#btnNoteSubmit").prop('value', 'Submit');
                    $("#CommonNote").val("");
                    $("#hrfCommonNotesId").val("");
                    $("#hrfNursingHomeId").val("");
                }

            });
        });

        function NursingHomeSearch() {
            var eleClientSearch = $('#NursingHomeSearch').autocomplete({
                scroll: true,
                minLength: 0,
                source: function (request, response) {
                    $.ajax({
                        type: "POST",
                        dataType: "json",
                        url: $('#hrfSearchClient').val(),
                        data: { Prefix: request.term },
                        success: function (data) {
                            response($.map(data, function (item) {
                                return { label: item.value, value: item.value, Id: item.id };
                            }));
                        },
                        error: function (req, status, error) {
                        }
                    });
                },
                select: function (event, ui) {
                    $('#hrfNursingHomeId').val(ui.item.Id);
                    NursingHomeDetailsLoad();
                    return ui.item.value;
                },
            }).focus(function () {
                $(this).autocomplete("search", "");
            });
        }

        function NursingHomeDetailsLoad()
        {
            //$("#tcontractdetails").click();

            var url = "@Url.Action("NursingHomeDetails", "NursingHomes")";
            var jsonData = { Id: $('#hrfNursingHomeId').val() };

            AjaxRequestJsonPost(url, jsonData, function (resp, status, req) {
                $('#divNursingHomeSearch').html(resp);
                $('#divNursingHomeDetails').removeClass('hide');
                $('#divNursingHomeList').addClass('hide');
                NursingHomeSearch();
                logDatatable();
                NotesDatatable();
                NursingHomeContactsDatatable($('#hrfNursingHomeId').val(),0);

                $('#NursingHomeContacts').html(resp.NursingHomesContactsList);

                if ($('#@Html.IdFor(m => m.NursingHomeDetails.IsAlert)').val() == "True") {
                    swal({
                        title: "Delinquent facility, contact your supervisor",
                        //text: "Do you want to Continue?",
                        type: "warning",
                        //showCancelButton: true,
                        confirmButtonClass: 'btn-primary',
                        confirmButtonText: 'Ok'
                    });
                }

                if ($('#@Html.IdFor(m => m.NursingHomeDetails.ContractPricing)').val() == "False") {
                    $('.ContractPricing').html("No");

                }
                else {
                    $('.ContractPricing').html("Yes");
                    //<a href="_blank" class="btnLetterIncludedview fa fa-eye text-inverse form-control1 p-l-0 p-r-0 m-5 text-decoration"></a>
                }


                var LetterPath = '@Html.ActionLink("", "ViewFiles", "NursingHomes", new { fileName = "FN**" }, new { @target = "_blank", @class = "fa fa-eye text-inverse form-control1 p-l-0 p-r-0 m-5 text-decoration" })';
                LetterPath = LetterPath.replace('FN**', escape($('#@Html.IdFor(m => m.NursingHomeDetails.ID)').val()+'\\'+$('#@Html.IdFor(m => m.NursingHomeDetails.LetterPath)').val()));


                if ($('#@Html.IdFor(m => m.NursingHomeDetails.LetterIncluded)').val() == "False") {
                    $('.LetterIncluded').html("No");
                }
                else {
                    $('.LetterIncluded').html("Yes" + LetterPath);
                    //<a href="_blank" class="btnLetterIncludedview fa fa-eye text-inverse form-control1 p-l-0 p-r-0 m-5 text-decoration"></a>
                }
                var W9Path = '@Html.ActionLink("", "ViewFiles", "NursingHomes", new { fileName = "FN**" }, new { @target = "_blank", @class = "fa fa-eye text-inverse form-control1 p-l-0 p-r-0 m-5 text-decoration" })';
                W9Path = W9Path.replace('FN**', escape($('#@Html.IdFor(m => m.NursingHomeDetails.ID)').val()+'\\'+$('#@Html.IdFor(m => m.NursingHomeDetails.W9Path)').val()));

                if ($('#@Html.IdFor(m => m.NursingHomeDetails.W9)').val() == "False") {
                    $('.W9').html("No");
                }
                else {
                    $('.W9').html("Yes" + W9Path);
                }

                var VendorPath = '@Html.ActionLink("", "ViewFiles", "NursingHomes", new { fileName = "FN**" }, new { @target = "_blank", @class = "fa fa-eye text-inverse form-control1 p-l-0 p-r-0 m-5 text-decoration" })';
                VendorPath = VendorPath.replace('FN**', escape($('#@Html.IdFor(m => m.NursingHomeDetails.ID)').val()+'\\'+$('#@Html.IdFor(m => m.NursingHomeDetails.VendorPath)').val()));

                if ($('#@Html.IdFor(m => m.NursingHomeDetails.VendorLetter)').val() == "False") {
                    $('.VendorLetter').html("No");
                }
                else {
                    $('.VendorLetter').html("Yes" + VendorPath);
                }

                var InvoiceTemplatePath = '@Html.ActionLink("", "ViewFiles", "NursingHomes", new { fileName = "FN**" }, new { @target = "_blank", @class = "fa fa-eye text-inverse form-control1 p-l-0 p-r-0 m-5 text-decoration" })';
                InvoiceTemplatePath = InvoiceTemplatePath.replace('FN**', escape($('#@Html.IdFor(m => m.NursingHomeDetails.ID)').val()+'\\'+$('#@Html.IdFor(m => m.NursingHomeDetails.InvoiceTemplatePath)').val()));

                if ($('#@Html.IdFor(m => m.NursingHomeDetails.InvoiceTemplate)').val() == "False") {
                    $('.InvoiceTemplate').html("No");
                }
                else {
                    $('.InvoiceTemplate').html("Yes" + InvoiceTemplatePath);
                }

            });
        }

         function logDatatable()
         {
             $("#divNursingHomeOtherDetails").addClass('hide');
             $("#divNursingHomeOtherDetails").addClass('show');
            var dtTblList;
            PageValue = $('#Page').val();
            if ($.fn.DataTable.isDataTable('#tblNursingHomeHistoryTable')) {
                dtTblList = $('#tblNursingHomeHistoryTable').DataTable().ajax.reload();

            } else
            {
                dtTblList = $('#tblNursingHomeHistoryTable').DataTable(
                   {
                       ajax: {
                           url: '@Url.Content("~/NursingHomes/NursingHomeLog")',
                           type: "POST",
                           datatype: "json",
                           data: function (d) {
                               d.nursingHomeId = $('#hrfNursingHomeId').val();
                           },
                           error: function (result) {
                               console.log(result);
                           }
                       },
                       columns: [
                           { data: "logTime", name: "date" },
                           { data: "userName", name: "actionby" },
                           { data: "comments", name: "action" },
                       ],
                       autoWidth: false,
                       order: [],
                       language: {
                           processing: "Processing...Please Wait"
                       }

                   })
                $(dtTblList.table().container()).removeClass('form-inline');


            }
        }

        function NotesDatatable() {
            var dtTblList;
            if ($.fn.DataTable.isDataTable('#tblNursingHomeNotesTable')) {
                dtTblList = $('#tblNursingHomeNotesTable').DataTable().ajax.reload();

            } else {
                dtTblList = $('#tblNursingHomeNotesTable').DataTable(
                   {
                       ajax: {
                           url: '@Url.Content("~/NursingHomes/NursingHomeNotesDetails")',
                           type: "POST",
                           datatype: "json",
                           data: function (d) {
                               d.NursingHomeId = $('#hrfNursingHomeId').val();
                           },
                           error: function (result) {
                               console.log(result);
                           }
                       },
                        columns: [
                           { data: "notes", name: "notes" },
                           { data: "addedBy", name: "added by" },
                           { data: "addedOn", name: "added on" },
                       ],
                       columnDefs: [
                       {
                           targets: 3,
                           render: function (data, type, row, meta) {
                               var Edit = '<a href="javascript:;" id="' + row["id"] + '" class="btnNotesedit fa fa-lg fa-edit text-inverse form-control1 p-l-0 p-r-0 m-5 @*@isPermission*@" style="border:none; background-color:transparent;display: initial;"></a>';
                               var Delete = '<a href="javascript:;" id="' + row["id"] + '" class="btnNotesdelete fa fa-lg fa-trash-o text-inverse form-control1 p-l-0 p-r-0 m-5 @*@isPermission*@" style="border:none; background-color:transparent;display: initial;"></a>';

                               if (row["userID"] == '@UserId' || '@RoleId' == '2c0cdf89-9984-4f82-bcf3-f3382e5a843c')
                                   return Edit + Delete;
                               else
                                   return '';
                           }
                       }
                       ],
                       autoWidth: false,
                       order: [],
                       language: {
                           processing: "Processing...Please Wait"
                       }

                   })
                $(dtTblList.table().container()).removeClass('form-inline');

                $('#tblNursingHomeNotesTable tbody td .btnNotesdelete').live('click', function () {
                    var tr = $(this).closest('tr');
                    var NotesID = $(this).attr("id");
                    $("#hrfCommonNotesId").val(NotesID);
                    ConfirmNotesDelete(NotesID);
                });

                $('#tblNursingHomeNotesTable tbody td .btnNotesedit').live('click', function () {
                    var tr = $(this).closest('tr');
                    var NotesID = $(this).attr("id");
                    EditNote(NotesID);

                });
            }
        }



         //Delete Notes
        function ConfirmNotesDelete(NotesID) {
            var response = swal({
                title: "Are you sure?",
                text: "You will not be able to recover this detail!",
                type: "error",
                showCancelButton: true,
                confirmButtonClass: 'btn-danger',
                confirmButtonText: 'Yes, delete it!'
            },
            function (isConfirm) {
                if (isConfirm) {
                    var url = "@Url.Action("DeleteNursingHomeNotes", "NursingHomes")";
                    var jsonData = { Id: NotesID };
                    AjaxRequestJsonPost(url, jsonData, function (resp, status, req) {
                        $("#hrfCommonNotesId").val("");
                        NotesDatatable();
                        logDatatable();
                    });
                }
                else {
                    return false;
                }
            });
        };

         //Edit Notes
        function EditNote(NotesID) {
            var url = "@Url.Action("EditNotes", "NursingHomes")";
            var formData = new FormData();
            formData.append('Id', NotesID);

            $.ajax({
                url: url,
                type: "POST",
                contentType: false,
                processData: false,
                data: formData,
                success: function (result) {
                    $("#hrfCommonNotesId").val(NotesID);
                    $("#hrfNursingHomeId").val(result.data[0]["nursingHomeId"]);
                    $("#CommonNote").val(result.data[0]["notes"]);
                    $("#btnNoteSubmit").prop('value', 'Update');

                    if (result.data[0]["nursingHomeId"] != 'undefined' && result.data[0]["nursingHomeId"] != null && result.data[0]["nursingHomeId"] != '') {
                        $($('#@Html.IdFor(m => m.NursingHomeNotes.NursingHomeId)')).val(result.data[0]["nursingHomeId"]);
                    }
                },
                error: function (err) {
                }
            });
        };

         $("#btnNoteSubmit").on('click', function () {
            $('#hrfCommonNotesId').attr("data-parsley-required", true);
            $('#CommonNote').attr("data-parsley-required", true);

            var validationresult = $('#NotesForm').parsley().validate();
            if (validationresult) {
                SaveNotes();
            }
        });

        $("#btnNoteClear").on('click', function () {
            $("#btnNoteSubmit").prop('value', 'Submit');
            $("#CommonNote").val("");
            $("#hrfCommonNotesId").val("");
           // $("#hrfNursingHomeId").val("");
            NotesDatatable();
        });

        function SaveNotes()
        {
            var GetId = $('#hrfCommonNotesId').val();
            GetId = (GetId == "" ? 0 : GetId);
            var GetNursingHomeId = $('#hrfNursingHomeId').val();
            var GetNotes = $('#CommonNote').val();

            var ClientContractNoteDetails = JSON.stringify({
                ID: GetId,
                NursingHomeId: GetNursingHomeId,
                Notes: GetNotes

            });
            var url = "@Url.Action("SaveNursingHomeNotes", "NursingHomes")";
            var formData = new FormData();
            formData.append('Id', GetId);
            formData.append('NursingHomeId', GetNursingHomeId);
            formData.append('Notes', GetNotes);

            $.ajax({
                url: url,
                type: "POST",
                contentType: false,
                processData: false,
                data: formData,
                success: function (result) {
                    NursingHomeDetailsLoad();
                },
                error: function (err) {
                }
            });


            $("#btnNoteSubmit").prop('value', 'Submit');
            $("#CommonNote").val("");
            $("#hrfCommonNotesId").val("");
            //$("#hrfNursingHomeId").val("");
            NotesDatatable();
        }

        function LoadNursingHomeList() {
            $('#tblNursingHomes').DataTable({
                searching: true,
                'aoColumnDefs': [{
                    'bSortable': false,
                    'aTargets': [-1]
                }],
                "columnDefs": [
                    { "type": "num", "targets": 0 }
                ],
                "order": [0, 'asc'],
                dom: 'l<"toolbar">frtip',
                initComplete: function () {
                    $("div.toolbar")
                       .html('<a id="btnNursingHomeExport" href="javascript:;" class="" title="Download"><i class="fa fa-lg fa-file-excel-o text-success"></i> </a>');
                    $('#btnNursingHomeExport').on('click', function () {
                        var url = "@Url.Action("DownloadNursingHomes", "NursingHomes")";
                        var jsonData = {};
                        AjaxRequestJsonPostContent(url, jsonData, function (resp, status, req) {
                            const a = document.createElement('a');
                            a.style.display = 'none';
