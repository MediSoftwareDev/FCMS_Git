        function ApprovalFacilityDatatable() {
            $('#divBoxesFacilityList').removeClass('hide');
            $('#divBoxesList').addClass('hide');
            $('#divBoxesGlobalReportList').addClass('hide');
            var dtTblApprovalList;

            if ($.fn.DataTable.isDataTable('#tblFacilityList')) {
                dtTblApprovalList = $('#tblFacilityList').DataTable().ajax.reload();
            }
            else {
                dtTblApprovalList = $('#tblFacilityList').DataTable(
                    {
                        ajax: {
                            url: '@Url.Content("~/Home/GetFacilityDashboardList")',
                            type: "POST",
                            datatype: "json",
                            data: function (d) {
                                d.BoxName = $("#hrfBoxId").val();
                            },
                            beforeSend: function () {
                                showLoader();   // ✅ show loader
                            },
                            error: function (result) {
                                console.log(result);
                            },
                            complete: function () {
                                hideLoader();   // ✅ always hide loader
                            }
                        },
                        columns: [
                            { data: "originalID", name: "originalID", "width": "0%", visible: false },
                            { data: "name", name: "name", "width": "25%" },
                            { data: "contactName", name: "contactName", "width": "10%" },
                            { data: "emailAddress", name: "emailAddress", "width": "20%" },
                            { data: "phone", name: "phone", "width": "10%" },
                            {
                                data: "billType",
                                name: "BillType",
                                width: "15%",
                                render: function (data, type, row, meta) {

                                    let options = `
                                        <option value="Single Invoice" ${data === 'Single Invoice' ? 'selected' : ''}>Single Invoice</option>
                                        <option value="Consolidated Invoice" ${data === 'Consolidated Invoice' ? 'selected' : ''}>Consolidated Invoice</option>
                                        <option value="Spreadsheet" ${data === 'Spreadsheet' ? 'selected' : ''}>Spreadsheet</option>
                                        <option value="HCFA 1500" ${data === 'HCFA 1500' ? 'selected' : ''}>HCFA 1500</option>
                                    `;

                                    return `<select class="form-control billTypeDropdown">
                                                ${options}
                                            </select>`;
                                }
                            },
                            { data: "instructions", name: "instructions", "width": "20%" }
                            
                        ],
                        autoWidth: false,
                        searching: true,
                        "order": [0, 'asc'],
                        language: {
                            processing: "Processing...Please Wait"
                        },
                    });

                $(dtTblApprovalList.table().container()).removeClass('form-inline');  
                
                //$('#tblFacilityList tbody tr').live('click', function (evt) {
                    //var data = dtTblApprovalList.row(this).data();
                    $('#tblFacilityList tbody td:first-child').live('click', function () {
                     var data = dtTblApprovalList.row($(this).closest('tr')).data();
                    if (data["facilityType"] == 'Hospitals') {
                        var baseUrl = '@Url.Content("~/Hospitals/Hospitals/?id=")';
                    }
                    else if (data["facilityType"] == 'Hospices') {
                        var baseUrl = '@Url.Content("~/Hospices/Hospices/?id=")';
                    }
                    else if (data["facilityType"] == 'NursingHomes') {
                        var baseUrl = '@Url.Content("~/NursingHomes/NursingHomes/?id=")';
                    }
                    else if (data["facilityType"] == 'CorrectionalFacilities') {
                        var baseUrl = '@Url.Content("~/CorrectionalFacilities/CorrectionalFacilities/?id=")';
                    }
                    var url = baseUrl + data["originalID"];
                    window.location.href = url;
                });
            }
        }

       
