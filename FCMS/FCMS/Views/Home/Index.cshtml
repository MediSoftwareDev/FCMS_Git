           function ClientFacilityAgingwithNotesBalanceDatatable() {

            $('#divBoxesList').removeClass('hide');
            $('#divBoxesFacilityList').addClass('hide');

            var tableId = '#tblUserList';
            var boxValue = $("#hrfBoxId").val();

            console.log(boxValue);

            // If already initialized → reload
            if ($.fn.DataTable.isDataTable(tableId)) {
                $(tableId).DataTable().ajax.reload(null, false);
                return;
            }

            // Initialize DataTable
            $(tableId).DataTable({
                processing: true,
                serverSide: false, // change to true only if using server-side paging

                ajax: {
                    url: '@Url.Content("~/Home/GetDashboardList1")',
                    type: "POST",
                    dataType: "json",
                    dataSrc: "data", // ✅ IMPORTANT (matches controller return)

                    data: function (d) {
                        d.BoxName = $("#hrfBoxId").val();
                    },

                    beforeSend: function () {
                        showLoader(); // optional
                    },

                    complete: function () {
                        hideLoader(); // ✅ loader stops here
                    },

                    error: function (xhr, error, thrown) {
                        console.log("Error:", xhr.responseText);
                    }
                },

                columns: [
                    { data: "id", name: "id", width: "10%" },
                    { data: "facilityName", name: "facilityName", width: "30%" },
                    { data: "noofAccounts", name: "noofAccounts", width: "30%" },
                    {
                        data: "balance",
                        name: "balance",
                        width: "30%",
                        render: function (data) {
                            return data ? "$ " + parseFloat(data).toFixed(2) : "$ 0.00";
                        }
                    }
                ],

                autoWidth: false,
                searching: true,
                ordering: true,
                order: [[0, 'asc']],

                language: {
                    processing: "Processing... Please Wait"
                },

                destroy: true // ✅ avoids reinitialization errors
            });
        }

