        function ApprovalFacilityDatatable() {
            $('#divBoxesFacilityList').removeClass('hide');
            $('#divBoxesList').addClass('hide');

            var dtTblApprovalList;

            if ($.fn.DataTable.isDataTable('#tblFacilityList')) {
                dtTblApprovalList = $('#tblFacilityList').DataTable().ajax.reload();
            }
            else {
                dtTblApprovalList = $('#tblFacilityList').DataTable(
                    {
                        ajax: {
                            url: '@Url.Content("~/Home/GetFacilityDashboardList")',
                            type: "POST",
                            datatype: "json",
                            data: function (d) {
                                d.BoxName = $("#hrfBoxId").val();
                            },
                            error: function (result) {
                                console.log(result);
                            }
                        },
                        columns: [
                            { data: "originalID", name: "originalID", "width": "0%", visible: false },
                            { data: "name", name: "name", "width": "30%" },
                            { data: "contactName", name: "contactName", "width": "25%" },
                            { data: "emailAddress", name: "emailAddress", "width": "25%" },
                            { data: "invoicePreference", name: "invoicePreference", "width": "10%" },
                            { data: "invoiceSchedule", name: "invoiceSchedule", "width": "10%" },
                            { data: "facilityType", name: "facilityType", "width": "0%", visible: false }
                        ],
                        autoWidth: false,
                        searching: true,
                        "order": [0, 'asc'],
                        language: {
                            processing: "Processing...Please Wait"
                        },
                    });

                $(dtTblApprovalList.table().container()).removeClass('form-inline');

                $('#tblFacilityList tbody tr').live('click', function (evt) {
                    var data = dtTblApprovalList.row(this).data();
                    if (data["facilityType"] == 'Hospitals') {
                        var baseUrl = '@Url.Content("~/Hospitals/Hospitals/?id=")';
                    }
                    else if (data["facilityType"] == 'Hospices') {
                        var baseUrl = '@Url.Content("~/Hospices/Hospices/?id=")';
                    }
                    else if (data["facilityType"] == 'NursingHomes') {
                        var baseUrl = '@Url.Content("~/NursingHomes/NursingHomes/?id=")';
                    }
                    else if (data["facilityType"] == 'CorrectionalFacilities') {
                        var baseUrl = '@Url.Content("~/CorrectionalFacilities/CorrectionalFacilities/?id=")';
                    }
                    var url = baseUrl + data["originalID"];
                    window.location.href = url;
                });
            }
        }

       
