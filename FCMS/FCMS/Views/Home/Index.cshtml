                                        // 4th column (index 3)
                                        let dateValue = $('td:eq(4)', row).text().trim();

                                        if (dateValue !== '') {

                                            // If your date format is MM/dd/yyyy
                                            let parts = dateValue.split('/');

                                            if (parts.length === 4) {

                                                let cellDate = new Date(parts[2], parts[0] - 1, parts[1]);

                                                let currentDate = new Date();

                                                let diffDays = Math.floor(
