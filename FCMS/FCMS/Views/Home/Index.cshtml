        function ClientFacilityAgingwithNotesBalanceDatatable(BoxName) {
            $('#divBoxesList').addClass('hide');
             $('#divBoxesFacilityList').addClass('hide');
             $('#divBoxesGlobalReportList').removeClass('hide');
                $.ajax({
                    url: '@Url.Content("~/Home/GetDashboardListForClientAgingWithNotesB6")',                    
                    type: 'POST',
                    data: { BoxName: BoxName },
                    beforeSend: function () {
                        showLoader();   // ✅ show loader
                    },
                    success: function (response) {

                        let data = response.data;

                        if (!data || data.length === 0) {
                            $('#tblFacilityGlobalReportList').html('<tr><td>No Data</td></tr>');
                            return;
                        }

                        let columns = [];

                        Object.keys(data[0]).forEach(function (key) {
                            columns.push({
                                title: key,
                                data: key
