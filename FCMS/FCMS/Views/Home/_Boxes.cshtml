<style>
    .custom-box {
        border: 2px solid #333;
        background-color: #e6cfc2; /* light peach */
        padding: 0;
        flex-direction: column;
        justify-content:space-between;
        height:167px;
        
    }

        /* Header (top section) */
        .custom-box .box-header {
            text-align: left;
            padding: 25px 10px;
            font-weight: bolder;
            margin-bottom:15px;
            

        }

            .custom-box .box-header h4 {
                text-transform: uppercase;
                margin: 0;
                font-size: 16px;
                letter-spacing: 0px;
                font-weight: bolder;
            }

        /* Footer (bottom section) */
        .custom-box .box-footer {
            display: flex;
            justify-content: space-between;
            background-color: skyblue;
            padding: 10px 15px;
            font-weight: bold;
            margin-top: 15%;
        }
        /* Note Management style*/
        .custom-box .box-footer-nm {
            display: flex;
            justify-content: space-between;
            background-color: skyblue;
            padding: 10px 15px;
            font-weight: bold;
            margin-top:-8%;
            color:black;
            
        }

            .custom-box .box-footer .left,
            .custom-box .box-footer .right {
                font-size: 14px;
                color:black;
            }
    /* Row for NE Facility & Correctional */
    .header-row {
        display: flex;
        justify-content: space-between;
        color:black;
        margin-top: 15%;
    }

        /* Left & Right text */
        .header-row .left {
            text-align: left;
            font-weight: 600;
        }

        .header-row .right {
            text-align: right;
            font-weight: 600;
        }
</style>
