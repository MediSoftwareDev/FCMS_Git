@using WiseX.ViewModels.Home
@model HomeViewModel
<style>
            .dashboard-card {
                border-radius: 18px;
                padding: 20px;
                color: #fff;
                position: relative;
                overflow: hidden;
                box-shadow: 0 10px 25px rgba(0,0,0,.08);
                transition: all .3s ease;
                min-height: 220px;
                margin-bottom: 20px;
            }

            .dashboard-card:hover {
                transform: translateY(-5px);
                box-shadow: 0 18px 35px rgba(0,0,0,.15);
            }

            .card-title {
                font-size: 20px;
                font-weight: 700;
                text-transform: uppercase;
                line-height: 1.4;
                margin-bottom: 25px;
            }

            .card-icon {
                position: absolute;
                top: 20px;
                right: 20px;
                font-size: 30px;
                opacity: .25;
            }

            .stats {
                display: flex;
                gap: 10px;
            }

            .stat-box {
                flex: 1;
                background: rgba(255,255,255,.15);
                backdrop-filter: blur(10px);
                border-radius: 12px;
                padding: 15px;
                text-align: center;
            }

            .stat-label {
                font-size: 12px;
                text-transform: uppercase;
                opacity: .9;
                font-weight: 600;
            }

            .stat-value {
                font-size: 22px;
                font-weight: 700;
                margin-top: 5px;
            }

            .clickable {
                cursor: pointer;
                color: #fff;
                text-decoration: none;
            }

            .clickable:hover {
                color: #fef08a;
            }

            /* gradients */
            /* 1 */
            .card-blue {
                background: linear-gradient(135deg,#2563eb,#60a5fa);
            }

            /* 2 */
            .card-green {
                background: linear-gradient(135deg,#059669,#34d399);
            }

            /* 3 */
            .card-purple {
                background: linear-gradient(135deg,#7c3aed,#c084fc);
            }

            /* 4 */
            .card-orange {
                background: linear-gradient(135deg,#ea580c,#fdba74);
            }

            /* 5 */
            .card-red {
                background: linear-gradient(135deg,#dc2626,#f87171);
            }

            /* 6 */
            .card-teal {
                background: linear-gradient(135deg,#0f766e,#5eead4);
            }

            /* 7 */
            .card-indigo {
                background: linear-gradient(135deg,#4338ca,#818cf8);
            }

            /* 8 */
            .card-cyan {
                background: linear-gradient(135deg,#0891b2,#67e8f9);
            }

            /* 9 */
            .card-pink {
                background: linear-gradient(135deg,#db2777,#f9a8d4);
            }

            /* 10 */
            .card-olive {
                background: linear-gradient(135deg,#4d7c0f,#bef264);
            }

            /* 11 */
            .card-gold {
                background: linear-gradient(135deg,#ca8a04,#fde047);
            }

            /* 12 */
            .card-slate {
                background: linear-gradient(135deg,#334155,#94a3b8);
            }
      
</style>
<div class="panel panel-inverse p-10">
    <div class="panel-body panel-form p-t-15 m-t-10">
        <!-- begin row -->
        <div class="row m-l-5">
            <!-- begin col-4 -->  
            <div class="col-md-3 col-sm-6">

                <div class="dashboard-card card-teal">

                    <div class="card-icon">
                        <i class="fa fa-hospital-o"></i>
                    </div>

                    <div class="card-title">
                        Non-Emergency Facility Balance
                    </div>

                    <div class="stats">

                        <div class="stat-box">
                            <div class="stat-label">
                                Accounts
                            </div>

                            <div class="stat-value">
                                @Model.ChartBoxes.NonEmergencyFacilityBalanceCount
                            </div>
                        </div>

                        <div class="stat-box">
                            <div class="stat-label">
                                Balance
                            </div>

                            <div class="stat-value">
                                <span id="NonEmergencyFacilityBalanceClick"
                                      class="clickable">
                                    $@Model.ChartBoxes.NonEmergencyFacilityBalance.ToString("N0")
                                </span>
                            </div>
                        </div>

                    </div>

                </div>

            </div>
                              
            <!-- end col-4 -->
            <!-- begin col-4 -->
            
                <div class="col-md-3 col-sm-6">

                <div class="dashboard-card card-orange">

                    <div class="card-icon">
                        <i class="fa fa-credit-card"></i>
                    </div>

