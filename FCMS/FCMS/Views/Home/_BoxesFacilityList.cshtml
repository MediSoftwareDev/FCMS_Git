@using WiseX.ViewModels.Home
@model HomeViewModel

<div class="panel panel-inverse" data-sortable-id="form-validation-1">
    <div class="panel-heading">
        <div class="panel-heading-btn">
            <a href="javascript:;" class="btn btn-xs btn-icon btn-circle btn-default collapsed" id="expandcollapse" data-click="panel-collapse" data-original-title="" title="" data-init="true"><i class="fa fa-minus"></i></a>
        </div>
        <h4 class="panel-title" id="FacilityName"></h4>
    </div>
    <div class="panel-body">
        <table id="tblFacilityList" class="table table-striped table-bordered table-hover">
            <thead>
                <tr>
                    <th hidden="hidden">ID</th>
                    <th>Hospital Name</th>
                    <th>Contact Name</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>Bill Type</th>
                    <th>Instructions</th>
                    <th hidden="hidden">Facility Type</th>
                </tr>
            </thead>
        </table>
    </div>
</div>