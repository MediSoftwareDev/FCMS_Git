    <script>
        $(document).ready(function () {
            // hideLoader(); hffacilityName
            var f_name= $('#hffacilityName').val();
            console.log(f_name)
           LoadNotesManagementDeailsList(f_name);
            // LoadDashboardExcel();
            if(@message.Count()>0)
            {
                $('#HNotifcationForm').modal('show');
            }
            hideLoader();
        });
        function LoadNotesManagementDeailsList(f_name)
        {
             // $('#divBoxesList').addClass('hide');
             // $('#divBoxesFacilityList').addClass('hide');
             // $('#divBoxesGlobalReportList').removeClass('hide');
                $.ajax({
                    url: '/Home/GetDashboardNoteManagementDetailList', 
                    type: 'POST',
                    data: { facilityName: f_name },
                    success: function (response) {

                        let data = response.data;

                        if (!data || data.length === 0) {
                            $('#tblNotesManagementDetailsList').html('<tr><td>No Data</td></tr>');
                            return;
                        }

                        let columns = [];

                        Object.keys(data[0]).forEach(function (key) {
                            columns.push({
                                title: key,
                                data: key
                            });
                        });

                        if ($.fn.DataTable.isDataTable('#tblNotesManagementDetailsList')) {
                            $('#tblNotesManagementDetailsList').DataTable().destroy();
                        }

                        $('#tblNotesManagementDetailsList').empty(); // IMPORTANT FIX

                        $('#tblNotesManagementDetailsList').DataTable({
                            data: data,
                            columns: columns,
                            paging: true,
                            searching: true,
                            ordering: true,
                            responsive: true
                        });
                    }
                });
        }
        </script>
    }