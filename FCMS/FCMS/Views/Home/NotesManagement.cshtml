    <script>
        $(document).ready(function () {
            // hideLoader(); hffacilityName
            showLoader();
            var f_name= $('#hffacilityName').val();
            console.log(f_name)
           LoadNotesManagementDeailsList(f_name);
            // LoadDashboardExcel();
            if(@message.Count()>0)
            {
                $('#HNotifcationForm').modal('show');
            }
            
        });
        function LoadNotesManagementDeailsList(f_name) {

            // Check if facility name is undefined, null, or empty
            if (f_name === undefined || f_name === null || $.trim(f_name) === "") {

                $('#tblNotesManagementDetailsList').html('<tr><td>No Data Found</td></tr>');
                 hideLoader();
                return; // Stop execution, don't call AJAX

            }

            $.ajax({
                url: '@Url.Content("~/Home/GetDashboardNoteManagementDetailList")',
                type: 'POST',
                data: { facilityName: f_name },
                success: function (response) {

                    let data = response.data;

                    if (!data || data.length === 0) {
                        $('#tblNotesManagementDetailsList').html('<tr><td>No Data Found</td></tr>');
                        return;
                    }

                    let columns = [];

                    Object.keys(data[0]).forEach(function (key) {
                        columns.push({
                            title: key,
                            data: key
                        });
                    });

                    if ($.fn.DataTable.isDataTable('#tblNotesManagementDetailsList')) {
                        $('#tblNotesManagementDetailsList').DataTable().destroy();
                    }

                    $('#tblNotesManagementDetailsList').empty();

                    $('#tblNotesManagementDetailsList').DataTable({
                        data: data,
                        columns: columns,
                        paging: true,
                        searching: true,
                        ordering: true,
                        responsive: true
                    });
                    hideLoader();
                }
            });
        }
       
        </script>
    }